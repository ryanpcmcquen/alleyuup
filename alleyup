#!/usr/bin/env bash
set -uo pipefail

# Ensure standard user and Homebrew binary paths are available (Apple Silicon & Intel Mac)
export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.openclaw/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:$PATH"

# Disable interactive confirmation prompts in Homebrew
export HOMEBREW_NO_ASK=1

ALLEYUP_VERSION="1.0.12"
TOOLS_GIST_ID="alleyuup-repo"
TOOLS_RAW_BASE="https://gist.githubusercontent.com/ryanpcmcquen/${TOOLS_GIST_ID}/raw"

BOLD="\033[1m"
BLUE="\033[1;34m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

CONFIG_FILE="${ALLEYUP_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/alleyup/config}"
REPO_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dots/repo"
: "${ALLEYUP_REPO_DIR:=${DOTFILES_GIST_DIR:-}}"

# Default step toggles (1 = enabled, 0 = disabled).
# Any of these can be overridden in ~/.config/alleyup/config (or via environment variables).
: "${ALLEYUP_SELF_UPDATE:=1}"
: "${ALLEYUP_BREW:=1}"
: "${ALLEYUP_BREW_FORMULA:=1}"
: "${ALLEYUP_BREW_CASK:=1}"
: "${ALLEYUP_BREW_GREEDY:=1}"
: "${ALLEYUP_BREW_CLEANUP:=1}"
: "${ALLEYUP_MAS:=1}"
: "${ALLEYUP_AGY:=1}"
: "${ALLEYUP_CLAUDE:=1}"
: "${ALLEYUP_OPENCODE_STANDALONE:=1}"
: "${ALLEYUP_OPENCLAW:=1}"
: "${ALLEYUP_NVM:=1}"
: "${ALLEYUP_NPM:=1}"
: "${ALLEYUP_PNPM:=1}"
: "${ALLEYUP_RUSTUP:=1}"
: "${ALLEYUP_UV:=1}"
: "${ALLEYUP_PIPX:=1}"
: "${ALLEYUP_GH_EXT:=1}"
: "${ALLEYUP_CODE_REPOS:=1}"
: "${ALLEYUP_CODE_DIR:=$HOME/code}"
: "${ALLEYUP_LOCAL_PROJECTS:=1}"
: "${ALLEYUP_BREWFILE:=1}"
: "${ALLEYUP_REPO_SYNC:=1}"
: "${ALLEYUP_SHELL:=1}"
: "${ALLEYUP_MACOS:=1}"
: "${ALLEYUP_MACOS_MAJOR:=0}"

# Tracked machine config files (<repo_filename>:<target_path_in_home>)
ALLEYUP_CONFIG_MAPPINGS=(
  "alleyup.conf:$HOME/.config/alleyup/config"
  "config.fish:$HOME/.config/fish/config.fish"
  "openclaw.fish:$HOME/.config/fish/conf.d/openclaw.fish"
  "config.nu:$HOME/.config/nushell/config.nu"
  "env.nu:$HOME/.config/nushell/env.nu"
  "login.nu:$HOME/.config/nushell/login.nu"
  "mac_config.nu:$HOME/Library/Application Support/nushell/config.nu"
  "mac_env.nu:$HOME/Library/Application Support/nushell/env.nu"
  "mac_login.nu:$HOME/Library/Application Support/nushell/login.nu"
  "starship.toml:$HOME/.config/starship.toml"
  "zshrc:$HOME/.zshrc"
  "zprofile:$HOME/.zprofile"
  "zshenv:$HOME/.zshenv"
  "zlogin:$HOME/.zlogin"
  "bashrc:$HOME/.bashrc"
  "bash_profile:$HOME/.bash_profile"
  "bash_aliases:$HOME/.bash_aliases"
  "profile:$HOME/.profile"
  "inputrc:$HOME/.inputrc"
  "vimrc:$HOME/.vimrc"
  "emacs:$HOME/.emacs"
  "emacs_init.el:$HOME/.emacs.d/init.el"
  "emacs_early_init.el:$HOME/.emacs.d/early-init.el"
  "xdg_emacs_init.el:$HOME/.config/emacs/init.el"
  "xdg_emacs_early_init.el:$HOME/.config/emacs/early-init.el"
  "doom_init.el:$HOME/.config/doom/init.el"
  "doom_config.el:$HOME/.config/doom/config.el"
  "doom_packages.el:$HOME/.config/doom/packages.el"
  "spacemacs:$HOME/.spacemacs"
  "tmux.conf:$HOME/.tmux.conf"
  "gitconfig:$HOME/.gitconfig"
  "gh_config.yml:$HOME/.config/gh/config.yml"
  "flint.conf:$HOME/.config/flint/config"
  "opencode_cli.json:$HOME/.config/opencode/cli.json"
  "Preferences.sublime-settings:$HOME/Library/Application Support/Sublime Text/Packages/User/Preferences.sublime-settings"
  "Default (OSX).sublime-keymap:$HOME/Library/Application Support/Sublime Text/Packages/User/Default (OSX).sublime-keymap"
  "Package Control.sublime-settings:$HOME/Library/Application Support/Sublime Text/Packages/User/Package Control.sublime-settings"
