)

# Default branch names for ~/code repo checks (can be overridden in ~/.config/alleyup/config)
ALLEYUP_DEFAULT_BRANCHES=("main" "master" "dev" "staging")

# Optional exclusion arrays (can be populated in ~/.config/alleyup/config)
ALLEYUP_BREW_IGNORE=()
ALLEYUP_CASK_IGNORE=()
ALLEYUP_NPM_IGNORE=()
ALLEYUP_REPO_IGNORE=()

FAILED_STEPS=()
NON_DEFAULT_REPOS=()
REPO_PULL_ERRORS=()

resolve_self_repo() {
  local source="${BASH_SOURCE[0]}"
  while [[ -L "$source" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  local candidate
  candidate="$(cd -P "$(dirname "$source")" && pwd)"
  if [[ -d "$candidate/.git" ]]; then
    printf "%s\n" "$candidate"
    return 0
  fi
  return 1
}

get_machine_repo() {
  if [[ -n "${ALLEYUP_REPO_DIR:-}" ]]; then
    local expanded="${ALLEYUP_REPO_DIR/#\~/$HOME}"
    if [[ -d "$expanded" ]]; then
      printf "%s\n" "$expanded"
      return 0
    fi
  fi
  if [[ -f "$REPO_CONFIG_FILE" ]]; then
    local saved
    saved="$(head -n 1 "$REPO_CONFIG_FILE" | tr -d '\r\n')"
    if [[ -n "$saved" ]] && [[ -d "$saved" ]]; then
      printf "%s\n" "$saved"
      return 0
    fi
  fi
  return 1
}

configure_machine_repo() {
  local input="${1:-}"
  if command -v dots >/dev/null 2>&1; then
    dots repo "$input"
    sync_machine_repo
    return $?
  fi

  if [[ -z "$input" ]]; then
    printf "\n${BOLD}${BLUE}==> Configure Machine Config / Brewfile Repository${RESET}\n"
    printf "Specify how to track configs & Brewfile on this machine:\n"
    printf "  - Enter a ${BOLD}local directory path${RESET} (e.g. ~/code/my-dots)\n"
    printf "  - Enter a ${BOLD}Gist ID or Git URL${RESET} to clone into ~/code/\n"
    printf "  - Enter ${BOLD}new${RESET} to create & clone a new private GitHub Gist for this machine\n\n"
    read -r -p "Repo path, Gist ID/URL, or 'new': " input
  fi

  input="${input#"${input%%[![:space:]]*}"}"
  input="${input%"${input##*[![:space:]]}"}"
  if [[ -z "$input" ]]; then
    printf "${RED}Aborted: no repository specified.${RESET}\n" >&2
    exit 1
  fi

  local target_dir=""
  if [[ "$input" == "new" ]]; then
    if ! command -v gh >/dev/null 2>&1; then
      printf "${RED}'gh' CLI is required to create a new Gist automatically.${RESET}\n" >&2
      exit 1
    fi
    local host tmp_dir gist_url gist_id
    host="$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo "mac")"
    tmp_dir="$(mktemp -d)"
    printf "# Local Configs (%s)\n" "$host" > "$tmp_dir/README.md"
    printf "${BLUE}==> Creating new private Gist for %s...${RESET}\n" "$host"
    gist_url="$(gh gist create "$tmp_dir/README.md" --desc "Local configs ($host)" | tail -n 1)"
    rm -rf "$tmp_dir"
    gist_id="${gist_url##*/}"
    target_dir="$HOME/code/$gist_id"
    mkdir -p "$HOME/code"
    git clone "git@gist.github.com:${gist_id}.git" "$target_dir" 2>/dev/null || git clone "https://gist.github.com/${gist_id}.git" "$target_dir"
  elif [[ "$input" =~ ^[0-9a-fA-F]{20,40}$ ]]; then
    target_dir="$HOME/code/$input"
    if [[ ! -d "$target_dir/.git" ]]; then
      mkdir -p "$HOME/code"
      printf "${BLUE}==> Cloning Gist %s into %s...${RESET}\n" "$input" "$target_dir"
      git clone "git@gist.github.com:${input}.git" "$target_dir" 2>/dev/null || git clone "https://gist.github.com/${input}.git" "$target_dir"
    fi
  elif [[ "$input" =~ ^(git@|https?://|ssh://) ]]; then
    local base
    base="$(basename "$input" .git)"
    target_dir="$HOME/code/$base"
    if [[ ! -d "$target_dir/.git" ]]; then
      mkdir -p "$HOME/code"
      printf "${BLUE}==> Cloning %s into %s...${RESET}\n" "$input" "$target_dir"
      git clone "$input" "$target_dir"
    fi
  else
    target_dir="${input/#\~/$HOME}"
    mkdir -p "$target_dir"
    target_dir="$(cd -P "$target_dir" && pwd)"
    if [[ ! -d "$target_dir/.git" ]]; then
      printf "${BLUE}==> Initializing new Git repository in %s...${RESET}\n" "$target_dir"
      git -C "$target_dir" init -b main
    fi
  fi

  mkdir -p "$(dirname "$REPO_CONFIG_FILE")"
  printf "%s\n" "$target_dir" > "$REPO_CONFIG_FILE"
  printf "${GREEN}✓ Saved machine config repo:${RESET} %s (stored in %s)\n" "$target_dir" "$REPO_CONFIG_FILE"
  sync_machine_repo
}

get_version_string() {
  local repo
  if repo="$(resolve_self_repo 2>/dev/null)"; then
    local sha count dirty=""
    sha="$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
    count="$(git -C "$repo" rev-list --count HEAD 2>/dev/null || echo "0")"
    if [[ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]]; then
      dirty="-dirty"
    fi
    printf "%s (r%s, %s%s)" "$ALLEYUP_VERSION" "$count" "$sha" "$dirty"
  else
    printf "%s (standalone)" "$ALLEYUP_VERSION"
  fi
}

check_version_status() {
  local ver
  ver="$(get_version_string)"
  printf "alleyup v%s\n" "$ver"

  local repo
  if repo="$(resolve_self_repo 2>/dev/null)" && git -C "$repo" remote get-url origin >/dev/null 2>&1; then
    local branch local_sha remote_sha
    branch="$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || echo "main")"
    local_sha="$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo "")"
    remote_sha="$(git -C "$repo" ls-remote origin "refs/heads/$branch" 2>/dev/null | awk '{print $1}')"
    if [[ -n "$remote_sha" ]]; then
      if [[ "$local_sha" == "$remote_sha" ]]; then
        printf "${GREEN}✓ Up to date with remote (%s)${RESET}\n" "${remote_sha:0:7}"
      else
        printf "${YELLOW}⚠ Update available on remote: %s -> %s (run 'alleyup' or 'dots pull')${RESET}\n" "${local_sha:0:7}" "${remote_sha:0:7}"
      fi
    fi
  elif command -v curl >/dev/null 2>&1; then
    local remote_ver
    remote_ver="$(curl -fsSL "${TOOLS_RAW_BASE}/alleyup?$(date +%s)" 2>/dev/null | awk -F'"' '/^ALLEYUP_VERSION=/{print $2; exit}')"
    if [[ -n "$remote_ver" ]]; then
      if [[ "$remote_ver" == "$ALLEYUP_VERSION" ]]; then
        printf "${GREEN}✓ Up to date with remote (v%s)${RESET}\n" "$remote_ver"
      else
        printf "${YELLOW}⚠ Update available on remote: v%s -> v%s (run 'alleyup')${RESET}\n" "$ALLEYUP_VERSION" "$remote_ver"
      fi
    fi
  fi
}

write_default_config() {
  local file="$1"
  mkdir -p "$(dirname "$file")"
  cat <<'EOF' > "$file"
# alleyup per-machine configuration
# Tracked via `dots` (symlinked from ~/.config/alleyup/config -> <machine-gist>/alleyup.conf)
#
# Set any step to 0 to disable it on this machine if something is broken or unwanted.

ALLEYUP_SELF_UPDATE=1          # Pull latest alleyup & dots from the tools Gist
ALLEYUP_BREW=1                 # Run Homebrew updates
ALLEYUP_BREW_FORMULA=1         # Upgrade Homebrew formulas
ALLEYUP_BREW_CASK=1            # Upgrade Homebrew casks
ALLEYUP_BREW_GREEDY=1          # Pass --greedy when upgrading casks
ALLEYUP_BREW_CLEANUP=1         # Run brew cleanup --prune=all
ALLEYUP_MAS=1                  # Upgrade Mac App Store apps via mas
ALLEYUP_AGY=1                  # Upgrade Antigravity CLI (agy)
ALLEYUP_CLAUDE=1               # Upgrade Claude Code CLI (claude update)
ALLEYUP_OPENCODE_STANDALONE=1  # Upgrade standalone ~/.opencode/bin/opencode (if present)
ALLEYUP_OPENCLAW=1             # Upgrade OpenClaw CLI (if not app-managed)
ALLEYUP_NVM=1                  # Run 'nvm install --lts' if npm is missing and nvm is installed
ALLEYUP_NPM=1                  # Upgrade global npm packages (skips local file: links)
ALLEYUP_PNPM=1                 # Upgrade global pnpm packages
ALLEYUP_RUSTUP=1               # Upgrade Rust toolchains via rustup
ALLEYUP_UV=1                   # Upgrade uv tools
ALLEYUP_PIPX=1                 # Upgrade pipx packages
ALLEYUP_GH_EXT=1               # Upgrade GitHub CLI extensions
ALLEYUP_CODE_REPOS=1           # Walk git repos in ALLEYUP_CODE_DIR, pull, and report branches
ALLEYUP_CODE_DIR="$HOME/code"  # Directory to scan for git repositories
ALLEYUP_LOCAL_PROJECTS=1       # Build & install local CLI repos (flint, scribe) after pulling
ALLEYUP_REPO_DIR=""            # Optional path to this machine's config/Brewfile git repo
ALLEYUP_BREWFILE=1             # Refresh tracked Brewfile in machine config repo
ALLEYUP_REPO_SYNC=1            # Collect local configs, commit, and push to machine config repo
ALLEYUP_SHELL=1                # Update Fisher plugins and Fish completions
ALLEYUP_MACOS=1                # Run macOS software updates (minor/patch & security updates)
ALLEYUP_MACOS_MAJOR=0          # Allow major macOS version upgrades (0 = block major OS upgrades)

# Default branches when checking git repos in ALLEYUP_CODE_DIR:
ALLEYUP_DEFAULT_BRANCHES=("main" "master" "dev" "staging")

# Package & repo exclusion lists (space-separated inside parentheses)
# Useful when a specific formula, cask, npm package, or git repo is broken on this machine:
ALLEYUP_BREW_IGNORE=()
ALLEYUP_CASK_IGNORE=()
ALLEYUP_NPM_IGNORE=()
ALLEYUP_REPO_IGNORE=()

# Optional hook functions (uncomment to override or extend behavior on this machine):
#
# alleyup_before() {
#   # Commands to run before standard upgrade steps
#   :
# }
#
# alleyup_after() {
#   # Commands to run after standard upgrade steps
#   :
# }
EOF
}

usage() {
  local self_repo="(standalone)"
  if self_repo="$(resolve_self_repo 2>/dev/null)"; then
    :
  fi
  local machine_repo="(not configured; run 'alleyup --repo')"
  if machine_repo="$(get_machine_repo 2>/dev/null)"; then
    :
  fi
  cat <<EOF
Usage: alleyup [options]

Upgrade local packages, casks, App Store apps, CLI tools, git repos, and macOS software.
  Tools repo:   $self_repo
  Machine repo: $machine_repo
  Local config: $CONFIG_FILE

Options:
  --no-macos, --fast   Skip macOS system software updates (softwareupdate)
  --no-repos           Skip pulling git repositories in ~/code
  --no-self-update     Skip pulling latest alleyup & dots from the tools Gist
  --repo [target]      Configure this machine's config/Brewfile repo (path, Gist ID/URL, or 'new')
  --config, --edit     Open $CONFIG_FILE in \$EDITOR (creates default if missing)
  --print-config       Print the path and contents of $CONFIG_FILE
  --check              Check version and whether a newer version is available on remote
  -v, --version        Print alleyup version and git revision
  -h, --help           Show this help message
EOF
}

# Load per-machine config file before parsing CLI flags so flags take precedence
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

ORIG_ARGS=("$@")
CONFIGURE_REPO_TARGET=""
RUN_CONFIGURE_REPO=0
while (( $# > 0 )); do
  arg="$1"
  shift
  case "$arg" in
    --no-macos|--fast)
      ALLEYUP_MACOS=0
      ;;
    --no-repos)
      ALLEYUP_CODE_REPOS=0
      ;;
    --no-self-update)
      ALLEYUP_SELF_UPDATE=0
      ;;
    --repo)
      RUN_CONFIGURE_REPO=1
      if (( $# > 0 )) && [[ "$1" != -* ]]; then
        CONFIGURE_REPO_TARGET="$1"
        shift
      fi
      ;;
    --repo=*)
      RUN_CONFIGURE_REPO=1
      CONFIGURE_REPO_TARGET="${arg#--repo=}"
      ;;
    --config|--edit)
      if [[ ! -f "$CONFIG_FILE" ]]; then
        write_default_config "$CONFIG_FILE"
        printf "${GREEN}✓ Created default config at %s${RESET}\n" "$CONFIG_FILE"
      fi
      ${EDITOR:-vi} "$CONFIG_FILE"
      exit 0
      ;;
    --print-config)
      printf "${BLUE}# %s${RESET}\n" "$CONFIG_FILE"
      if [[ -f "$CONFIG_FILE" ]]; then
        cat "$CONFIG_FILE"
      else
        printf "(No config file found at %s; run 'alleyup --config' to create one)\n" "$CONFIG_FILE"
      fi
      exit 0
      ;;
    -v|--version)
      printf "alleyup v%s\n" "$(get_version_string)"
      exit 0
      ;;
    --check)
      check_version_status
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf "${RED}Unknown option: %s${RESET}\n\n" "$arg" >&2
      usage >&2
      exit 1
      ;;
  esac
done

section() {
  printf "\n${BLUE}==> %s${RESET}\n" "$1"
}

run_step() {
  local name="$1"
  shift
  section "$name"
  if "$@"; then
    printf "${GREEN}✓ %s complete${RESET}\n" "$name"
  else
    local status=$?
    printf "${YELLOW}⚠ %s exited with status %d${RESET}\n" "$name" "$status" >&2
    FAILED_STEPS+=("$name")
  fi
}

in_array() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

# Verify a command exists AND is not a broken '#!/usr/bin/env node' wrapper on a machine without node
has_working_cmd() {
  local cmd="$1"
  local bin_path
  bin_path="$(command -v "$cmd" 2>/dev/null || true)"
  [[ -z "$bin_path" ]] && return 1
  if ! command -v node >/dev/null 2>&1 && [[ -f "$bin_path" ]]; then
    local first_line
    IFS= read -r first_line < "$bin_path" 2>/dev/null || true
    if [[ "$first_line" == "#!"*node* ]]; then
      return 1
    fi
  fi
  return 0
}

self_update_tools() {
  local repo
  if repo="$(resolve_self_repo)"; then
    if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
      if [[ -z "$(git -C "$repo" status --porcelain 2>/dev/null)" ]]; then
        local branch before_sha after_sha
        branch="$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || echo "main")"
        before_sha="$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo "")"
        if ! git -C "$repo" pull --rebase --quiet origin "$branch" 2>/dev/null; then
          # Fallback to HTTPS pull if SSH isn't configured on this machine
          git -C "$repo" pull --rebase --quiet "https://gist.github.com/${TOOLS_GIST_ID}.git" "$branch"
        fi
        after_sha="$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo "")"
        if [[ -n "$before_sha" ]] && [[ "$before_sha" != "$after_sha" ]]; then
          printf "Updated alleyup & dots (%s -> %s); restarting alleyup with new version...\n" "${before_sha:0:7}" "${after_sha:0:7}"
          if (( ${#ORIG_ARGS[@]} > 0 )); then
            exec "$0" --no-self-update "${ORIG_ARGS[@]}"
          else
            exec "$0" --no-self-update
          fi
        else
          printf "alleyup & dots are already up to date (%s).\n" "${after_sha:0:7}"
        fi
      else
        printf "Tools repo (%s) has local uncommitted changes; skipping pull.\n" "$repo"
      fi
    fi
    return 0
  fi

  # Standalone fallback: self-update directly via curl if not inside a git clone
  if command -v curl >/dev/null 2>&1; then
    local self_path="${BASH_SOURCE[0]}"
    local tmp_file="${self_path}.tmp.$$"
    if curl -fsSL "${TOOLS_RAW_BASE}/alleyup?$(date +%s)" -o "$tmp_file" 2>/dev/null && bash -n "$tmp_file" 2>/dev/null; then
      if ! cmp -s "$tmp_file" "$self_path"; then
        chmod +x "$tmp_file"
        mv "$tmp_file" "$self_path"
        local new_ver
        new_ver="$(awk -F'"' '/^ALLEYUP_VERSION=/{print $2; exit}' "$self_path")"
        printf "Updated standalone alleyup to v%s; restarting alleyup with new version...\n" "${new_ver:-latest}"
        if (( ${#ORIG_ARGS[@]} > 0 )); then
          exec "$self_path" --no-self-update "${ORIG_ARGS[@]}"
        else
          exec "$self_path" --no-self-update
        fi
      else
        rm -f "$tmp_file"
        printf "Standalone alleyup is already up to date (v%s).\n" "$ALLEYUP_VERSION"
      fi
    else
      rm -f "$tmp_file"
      printf "Could not fetch standalone update from Gist.\n"
      return 1
    fi
  fi
}

update_homebrew() {
  brew update

  if (( ALLEYUP_BREW_FORMULA == 1 )); then
    if (( ${#ALLEYUP_BREW_IGNORE[@]} > 0 )); then
      local formulas=()
      while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        if in_array "$f" "${ALLEYUP_BREW_IGNORE[@]}"; then
          printf "Skipping ignored formula: %s\n" "$f"
        else
          formulas+=("$f")
        fi
      done < <(brew outdated --formula --quiet)
      if (( ${#formulas[@]} > 0 )); then
        brew upgrade --formula --no-ask "${formulas[@]}"
      else
        printf "No non-ignored formulas to upgrade.\n"
      fi
    else
      brew upgrade --formula --no-ask
    fi
  fi

  if (( ALLEYUP_BREW_CASK == 1 )); then
    if (( ${#ALLEYUP_CASK_IGNORE[@]} > 0 )); then
      local casks=()
      local out_cmd=(brew outdated --cask --quiet)
      (( ALLEYUP_BREW_GREEDY == 1 )) && out_cmd=(brew outdated --cask --greedy --quiet)
      while IFS= read -r c; do
        [[ -z "$c" ]] && continue
        if in_array "$c" "${ALLEYUP_CASK_IGNORE[@]}"; then
          printf "Skipping ignored cask: %s\n" "$c"
        else
          casks+=("$c")
        fi
      done < <("${out_cmd[@]}")
      if (( ${#casks[@]} > 0 )); then
        if (( ALLEYUP_BREW_GREEDY == 1 )); then
          brew upgrade --cask --greedy --no-ask "${casks[@]}"
        else
          brew upgrade --cask --no-ask "${casks[@]}"
        fi
      else
        printf "No non-ignored casks to upgrade.\n"
      fi
    else
      if (( ALLEYUP_BREW_GREEDY == 1 )); then
        brew upgrade --cask --greedy --no-ask
      else
        brew upgrade --cask --no-ask
      fi
    fi
  fi

  if (( ALLEYUP_BREW_CLEANUP == 1 )); then
    brew cleanup --prune=all
  fi
}

ensure_node_via_nvm() {
  if ! has_working_cmd npm; then
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    if [[ -s "$NVM_DIR/nvm.sh" ]]; then
      # shellcheck disable=SC1091
      source "$NVM_DIR/nvm.sh"
    fi
    if command -v nvm >/dev/null 2>&1; then
      run_step "Node LTS via nvm" nvm install --lts
    fi
  fi
}

update_npm_globals() {
  local pkgs=()
  local list_out
  list_out="$(npm list -g --depth=0 --parseable 2>/dev/null || true)"

  local root_dir=""
  local line
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if [[ -z "$root_dir" ]]; then
      root_dir="$line"
      continue
    fi
    # Skip symlinked local packages (equivalent to file: links)
    if [[ -L "$line" ]]; then
      continue
    fi
    local pkg="${line#"${root_dir}/node_modules/"}"
    [[ -z "$pkg" || "$pkg" == "$line" ]] && continue
    if (( ${#ALLEYUP_NPM_IGNORE[@]} > 0 )) && in_array "$pkg" "${ALLEYUP_NPM_IGNORE[@]}"; then
      printf "Skipping ignored global npm package: %s\n" "$pkg"
      continue
    fi
    pkgs+=("$pkg")
  done <<<"$list_out"

  if (( ${#pkgs[@]} > 0 )); then
    printf "Updating global npm packages: %s\n" "${pkgs[*]}"
    npm install -g --no-audit --no-fund --yes "${pkgs[@]/%/@latest}"
  else
    printf "No non-linked global npm packages to update.\n"
  fi
}

update_pnpm_globals() {
  local out
  out="$(pnpm list -g --depth=0 2>/dev/null || true)"
  if [[ -n "$out" ]] && [[ "$out" != *"No global packages found"* ]]; then
    pnpm update -g --latest
  else
    printf "No global pnpm packages installed.\n"
  fi
}

update_code_repos() {
  if [[ ! -d "$ALLEYUP_CODE_DIR" ]]; then
    printf "Directory %s does not exist; skipping.\n" "$ALLEYUP_CODE_DIR"
    return 0
  fi

  local self_repo="" machine_repo=""
  self_repo="$(resolve_self_repo 2>/dev/null || true)"
  machine_repo="$(get_machine_repo 2>/dev/null || true)"

  local dir
  while IFS= read -r dir; do
    [[ -z "$dir" ]] && continue
    if ! git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
      continue
    fi
    if [[ -n "$(git -C "$dir" rev-parse --show-prefix 2>/dev/null)" ]]; then
      continue
    fi

    # Skip the shared tools Gist and machine config Gist (already managed in dedicated steps)
    local abs_dir
    abs_dir="$(cd -P "$dir" 2>/dev/null && pwd || echo "$dir")"
    if [[ -n "$self_repo" && "$abs_dir" == "$self_repo" ]] || [[ -n "$machine_repo" && "$abs_dir" == "$machine_repo" ]]; then
      continue
    fi

    local repo_name
    repo_name="$(basename "$dir")"
    if (( ${#ALLEYUP_REPO_IGNORE[@]} > 0 )) && in_array "$repo_name" "${ALLEYUP_REPO_IGNORE[@]}"; then
      printf "  - %-22s %-28s skipped (ignored)\n" "$repo_name" ""
      continue
    fi

    local current_branch branch_label is_default_branch=1
    current_branch="$(git -C "$dir" branch --show-current 2>/dev/null || echo "")"
    branch_label="[${current_branch:-(detached)}]"

    if [[ -z "$current_branch" ]] || ! in_array "$current_branch" "${ALLEYUP_DEFAULT_BRANCHES[@]}"; then
      is_default_branch=0
      NON_DEFAULT_REPOS+=("- ${repo_name}: ${current_branch:-(detached)}")
    fi

    local dirty_count dirty_note=""
    dirty_count="$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    if (( dirty_count > 0 )); then
      dirty_note=" (${dirty_count} dirty)"
    fi

    local remotes
    remotes="$(git -C "$dir" remote 2>/dev/null || true)"
    if [[ -z "$remotes" ]]; then
      printf "  - %-22s ${CYAN}%-28s${RESET} skipped (no remote)%s\n" "$repo_name" "$branch_label" "$dirty_note"
      continue
    fi

    local origin_url
    origin_url="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
    if [[ "$origin_url" == /* ]] && [[ ! -e "$origin_url" ]]; then
      printf "  ${YELLOW}-${RESET} %-22s ${CYAN}%-28s${RESET} skipped (missing local remote)%s\n" "$repo_name" "$branch_label" "$dirty_note"
      continue
    fi

    local before_sha after_sha pull_out
    before_sha="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo "")"
    if pull_out="$(git -C "$dir" pull --all --quiet 2>&1)"; then
      after_sha="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo "")"
      local state_text="up to date"
      if [[ -n "$before_sha" && -n "$after_sha" && "$before_sha" != "$after_sha" ]]; then
        state_text="${GREEN}updated (${before_sha} -> ${after_sha})${RESET}"
      fi
      if (( is_default_branch == 1 )); then
        printf "  ${GREEN}✓${RESET} %-22s ${CYAN}%-28s${RESET} %b%s\n" "$repo_name" "$branch_label" "$state_text" "$dirty_note"
      else
        printf "  ${YELLOW}⚠${RESET} %-22s ${YELLOW}%-28s${RESET} %b%s ${YELLOW}(non-default branch)${RESET}\n" "$repo_name" "$branch_label" "$state_text" "$dirty_note"
      fi
    else
      local status=$?
      REPO_PULL_ERRORS+=("- ${repo_name} (exit ${status})")
      printf "  ${RED}✗${RESET} %-22s ${CYAN}%-28s${RESET} ${RED}pull failed (exit %d)${RESET}%s\n" "$repo_name" "$branch_label" "$status" "$dirty_note"
      if [[ -n "$pull_out" ]]; then
        printf "      %s\n" "${pull_out//$'\n'/$'\n      '}"
      fi
    fi
  done < <(find "$ALLEYUP_CODE_DIR" -maxdepth 2 -type d -not -name '.git' | sort)

  printf "\n"
  if (( ${#NON_DEFAULT_REPOS[@]} > 0 )); then
    printf "${YELLOW}Repos not on a default branch:${RESET}\n"
    printf "  %s\n" "${NON_DEFAULT_REPOS[@]}"
    printf "\n"
  fi

  if (( ${#REPO_PULL_ERRORS[@]} > 0 )); then
    printf "${YELLOW}Repo pull errors:${RESET}\n"
    printf "  %s\n" "${REPO_PULL_ERRORS[@]}"
    printf "\n"
    return 1
  fi
}

update_local_projects() {
  local flint_dir="$ALLEYUP_CODE_DIR/flint"
  if [[ -f "$flint_dir/Makefile" ]] && command -v make >/dev/null 2>&1; then
    printf "Building flint in %s...\n" "$flint_dir"
    if make -C "$flint_dir" force; then
      mkdir -p "$HOME/bin"
      cp -f "$flint_dir/flint" "$HOME/bin/flint"
      printf "${GREEN}✓ Installed %s/flint -> %s/bin/flint${RESET}\n" "$flint_dir" "$HOME"
    else
      printf "${YELLOW}⚠ Failed to build flint${RESET}\n" >&2
      return 1
    fi
  fi

  local scribe_dir="$ALLEYUP_CODE_DIR/scribe"
  if [[ -f "$scribe_dir/package.json" ]] && has_working_cmd npm; then
    printf "Building scribe in %s...\n" "$scribe_dir"
    if (cd "$scribe_dir" && npm install --no-audit --no-fund && npm run build); then
      if ! command -v scribe >/dev/null 2>&1; then
        (cd "$scribe_dir" && npm link) || true
      fi
      printf "${GREEN}✓ Built scribe (%s)${RESET}\n" "$scribe_dir"
    else
      printf "${YELLOW}⚠ Failed to build scribe${RESET}\n" >&2
      return 1
    fi
  fi
}

update_shell() {
  if command -v fish >/dev/null 2>&1; then
    if fish -c 'type -q fisher' 2>/dev/null; then
      printf "Updating Fisher plugins...\n"
      fish -c 'fisher update'
    fi
    printf "Updating Fish manpage completions...\n"
    fish -c 'fish_update_completions'
  fi

  if [[ -d "${ZSH:-$HOME/.oh-my-zsh}" ]] && command -v zsh >/dev/null 2>&1; then
    printf "Updating Oh My Zsh...\n"
    zsh -c 'ZSH="${ZSH:-$HOME/.oh-my-zsh}" "$ZSH/tools/upgrade.sh" -v minimal' 2>/dev/null || true
  fi
}

sync_machine_repo() {
  local machine_repo
  if ! machine_repo="$(get_machine_repo)"; then
    return 0
  fi

  # Ensure default alleyup config exists so it can be tracked
  if [[ ! -e "$CONFIG_FILE" ]] && [[ ! -e "$machine_repo/alleyup.conf" ]]; then
    write_default_config "$CONFIG_FILE"
  fi

  # 1. Collect and symlink local config files on this machine
  local entry repo_name target source_path
  for entry in "${ALLEYUP_CONFIG_MAPPINGS[@]}"; do
    repo_name="${entry%%:*}"
    target="${entry#*:}"
    source_path="$machine_repo/$repo_name"

    if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$source_path" ]]; then
      continue
    elif [[ -f "$target" ]] && [[ ! -L "$target" ]]; then
      cp -a "$target" "$source_path"
      ln -sfn "$source_path" "$target"
      printf "Tracked & linked %s -> %s\n" "$target" "$source_path"
    elif [[ ! -e "$target" ]] && [[ -f "$source_path" ]]; then
      mkdir -p "$(dirname "$target")"
      ln -sfn "$source_path" "$target"
      printf "Linked %s -> %s\n" "$target" "$source_path"
    fi
  done

  # 2. Dump Brewfile if enabled and Homebrew is installed
  if (( ALLEYUP_BREWFILE == 1 )) && command -v brew >/dev/null 2>&1; then
    if has_working_cmd npm; then
      brew bundle dump --file="$machine_repo/Brewfile" --force
    else
      HOMEBREW_BUNDLE_DUMP_NO_NPM=1 brew bundle dump --file="$machine_repo/Brewfile" --force
    fi
    printf "Updated %s/Brewfile\n" "$machine_repo"
  fi

  # 3. Commit and push to the machine config repo if it is a git repository
  if [[ -d "$machine_repo/.git" ]]; then
    # Remove default Gist placeholder file if real configs exist
    if [[ -f "$machine_repo/gistfile1.txt" ]] && [[ "$(wc -c <"$machine_repo/gistfile1.txt" | tr -d ' ')" -le 20 ]]; then
      git -C "$machine_repo" rm -f --quiet gistfile1.txt 2>/dev/null || rm -f "$machine_repo/gistfile1.txt"
    fi

    git -C "$machine_repo" add -A
    local host
    host="$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo "mac")"
    if ! git -C "$machine_repo" diff --cached --quiet; then
      git -C "$machine_repo" commit -m "alleyup: sync configs & Brewfile ($host, $(date '+%Y-%m-%d %H:%M'))"
    else
      printf "No new config or Brewfile changes to commit in %s.\n" "$machine_repo"
    fi

    if git -C "$machine_repo" remote get-url origin >/dev/null 2>&1; then
      local branch
      branch="$(git -C "$machine_repo" symbolic-ref --short HEAD 2>/dev/null | head -n 1 | tr -d '[:space:]')"
      [[ -z "$branch" ]] && branch="main"
      git -C "$machine_repo" pull --rebase --quiet origin "$branch" || true
      if [[ -n "$(git -C "$machine_repo" status --porcelain -b 2>/dev/null | grep '^## .*\[ahead ')" ]] || ! git -C "$machine_repo" diff --quiet "origin/$branch" HEAD 2>/dev/null; then
        git -C "$machine_repo" push origin "$branch"
        printf "Pushed machine configs to %s (%s)\n" "$machine_repo" "$branch"
      fi
    fi
  fi
}

update_macos() {
  if (( ALLEYUP_MACOS_MAJOR == 1 )); then
    softwareupdate -i -a --agree-to-license
    return $?
  fi

  local current_ver current_major
  current_ver="$(sw_vers -productVersion 2>/dev/null || echo "")"
  current_major="${current_ver%%.*}"

  printf "Checking for macOS updates (current: macOS %s; major upgrades blocked)...\n" "${current_ver:-unknown}"
  local list_out
  list_out="$(softwareupdate -l 2>&1 || true)"

  if grep -q "No new software available" <<<"$list_out"; then
    printf "No new macOS software updates available.\n"
    return 0
  fi

  local labels=()
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if [[ "$line" == SKIP:* ]]; then
      printf "${YELLOW}Skipping major macOS upgrade: %s${RESET}\n" "${line#SKIP:}"
    elif [[ "$line" == INSTALL:* ]]; then
      labels+=("${line#INSTALL:}")
    fi
  done < <(
    awk -v cur_maj="${current_major:-0}" '
      function flush() {
        if (label == "") return
        if (is_major) {
          print "SKIP:" label
        } else {
          print "INSTALL:" label
        }
        label = ""
        is_major = 0
      }
      /^[[:space:]]*\*[[:space:]]+Label:[[:space:]]*/ {
        flush()
        sub(/^[[:space:]]*\*[[:space:]]+Label:[[:space:]]*/, "", $0)
        sub(/[[:space:]]+$/, "", $0)
        label = $0
        if (cur_maj > 0 && match(label, /macOS[[:space:]]+([A-Za-z]+[[:space:]]+)?[0-9]+\.[0-9]+/)) {
          s = substr(label, RSTART, RLENGTH)
          if (match(s, /[0-9]+\./)) {
            maj = substr(s, RSTART, RLENGTH - 1) + 0
            if (maj != cur_maj) is_major = 1
          }
        }
        next
      }
      label != "" {
        if (cur_maj > 0 && $0 ~ /Title:[[:space:]]*macOS/ && match($0, /Version:[[:space:]]*[0-9]+\./)) {
          s = substr($0, RSTART, RLENGTH)
          if (match(s, /[0-9]+/)) {
            maj = substr(s, RSTART, RLENGTH) + 0
            if (maj != cur_maj) is_major = 1
          }
        }
      }
      END {
        flush()
      }
    ' <<<"$list_out"
  )

  if (( ${#labels[@]} > 0 )); then
    printf "Installing macOS updates: %s\n" "${labels[*]}"
    softwareupdate -i --agree-to-license "${labels[@]}"
  else
    printf "No minor/security macOS updates to install.\n"
  fi
}

# Handle --repo after all helper functions are defined
if (( RUN_CONFIGURE_REPO == 1 )); then
  configure_machine_repo "$CONFIGURE_REPO_TARGET"
  exit 0
fi

# 0. Self-update alleyup & dots from shared tools Gist (git repo or standalone curl)
printf "${BOLD}alleyup v%s${RESET}\n" "$(get_version_string)"
if (( ALLEYUP_SELF_UPDATE == 1 )); then
  run_step "Self-Update (alleyup)" self_update_tools
fi

# Run user pre-hook if defined in ~/.config/alleyup/config
if declare -F alleyup_before >/dev/null 2>&1; then
  run_step "Custom Pre-Upgrade Hook (alleyup_before)" alleyup_before
fi

# 1. Homebrew (Formulas, Casks, Cleanup)
if (( ALLEYUP_BREW == 1 )) && command -v brew >/dev/null 2>&1; then
  if declare -F alleyup_override_homebrew >/dev/null 2>&1; then
    run_step "Homebrew (Custom Override)" alleyup_override_homebrew
  else
    run_step "Homebrew (Formulas, Casks & Cleanup)" update_homebrew
  fi
fi

# 2. Mac App Store (mas)
if (( ALLEYUP_MAS == 1 )) && command -v mas >/dev/null 2>&1; then
  run_step "Mac App Store (mas)" mas upgrade
fi

# 3. Standalone CLI Tools
if (( ALLEYUP_AGY == 1 )) && has_working_cmd agy; then
  run_step "Antigravity CLI (agy)" agy update
fi

if (( ALLEYUP_CLAUDE == 1 )) && has_working_cmd claude; then
  # Only run standalone 'claude update' if claude is not already managed as a Homebrew cask
  if ! command -v brew >/dev/null 2>&1 || ! brew list --cask claude-code >/dev/null 2>&1; then
    run_step "Claude Code CLI (claude)" claude update
  fi
fi

if (( ALLEYUP_OPENCODE_STANDALONE == 1 )) && [[ -x "$HOME/.opencode/bin/opencode" ]]; then
  run_step "OpenCode (standalone)" "$HOME/.opencode/bin/opencode" upgrade
fi

if (( ALLEYUP_OPENCLAW == 1 )) && has_working_cmd openclaw; then
  if ! openclaw update status 2>/dev/null | grep -q "Managed by OpenClaw.app"; then
    run_step "OpenClaw CLI" openclaw update --yes
  fi
fi

# 4. Dev Toolchains & Global Packages
if (( ALLEYUP_NVM == 1 )); then
  ensure_node_via_nvm
fi

if (( ALLEYUP_NPM == 1 )) && has_working_cmd npm; then
  if declare -F alleyup_override_npm >/dev/null 2>&1; then
    run_step "Global npm Packages (Custom Override)" alleyup_override_npm
  else
    run_step "Global npm Packages" update_npm_globals
  fi
fi

if (( ALLEYUP_PNPM == 1 )) && has_working_cmd pnpm; then
  run_step "Global pnpm Packages" update_pnpm_globals
fi

if (( ALLEYUP_RUSTUP == 1 )) && command -v rustup >/dev/null 2>&1; then
  run_step "Rust Toolchains (rustup)" rustup update
fi

if (( ALLEYUP_UV == 1 )) && command -v uv >/dev/null 2>&1; then
  run_step "uv Tools" uv tool upgrade --all
fi

if (( ALLEYUP_PIPX == 1 )) && command -v pipx >/dev/null 2>&1; then
  run_step "pipx Packages" pipx upgrade-all
fi

if (( ALLEYUP_GH_EXT == 1 )) && command -v gh >/dev/null 2>&1; then
  if [[ -n "$(gh extension list 2>/dev/null || true)" ]]; then
    run_step "GitHub CLI Extensions" gh extension upgrade --all
  fi
fi

# 5. Git Repositories in ~/code
if (( ALLEYUP_CODE_REPOS == 1 )); then
  run_step "Git Repositories ($ALLEYUP_CODE_DIR)" update_code_repos
fi

# 5b. Build & install local CLI projects (flint, scribe)
if (( ALLEYUP_LOCAL_PROJECTS == 1 )) && [[ -d "$ALLEYUP_CODE_DIR/flint" || -d "$ALLEYUP_CODE_DIR/scribe" ]]; then
  run_step "Local CLI Projects (flint & scribe)" update_local_projects
fi

# 6. Collect local configs, refresh Brewfile, and push to machine config repo
if (( ALLEYUP_REPO_SYNC == 1 )) && get_machine_repo >/dev/null 2>&1; then
  run_step "Sync Machine Configs & Brewfile ($(get_machine_repo))" sync_machine_repo
fi

# 7. Shell & Completions
if (( ALLEYUP_SHELL == 1 )) && { command -v fish >/dev/null 2>&1 || [[ -d "${ZSH:-$HOME/.oh-my-zsh}" ]]; }; then
  run_step "Shell Plugins & Completions" update_shell
fi

# 8. macOS System Software
if (( ALLEYUP_MACOS == 1 )) && command -v softwareupdate >/dev/null 2>&1; then
  run_step "macOS Software Updates" update_macos
fi

# Run user post-hook if defined in ~/.config/alleyup/config
if declare -F alleyup_after >/dev/null 2>&1; then
  run_step "Custom Post-Upgrade Hook (alleyup_after)" alleyup_after
fi

printf "\n"
if (( ${#FAILED_STEPS[@]} > 0 )); then
  printf "${YELLOW}Finished with warnings in: %s${RESET}\n" "${FAILED_STEPS[*]}"
  exit 1
else
  printf "${BOLD}${GREEN}✨ All upgrades completed!${RESET}\n"
fi
