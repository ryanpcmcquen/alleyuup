# Snapshot ALLEYUUP_* values that were supplied in the environment so they win
# over the per-machine config file.
# Precedence: defaults < ~/.config/alleyuup/config < environment < CLI flags.
ALLEYUUP_OVERRIDABLE_VARS=(
  ALLEYUUP_SELF_UPDATE ALLEYUUP_BREW ALLEYUUP_BREW_FORMULA ALLEYUUP_BREW_CASK
  ALLEYUUP_BREW_GREEDY ALLEYUUP_BREW_CLEANUP ALLEYUUP_MAS ALLEYUUP_AGY
