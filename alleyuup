  ALLEYUUP_SCRIBE ALLEYUUP_JOBS ALLEYUUP_NET_TIMEOUT ALLEYUUP_LOCK_MAX_HOURS
  ALLEYUUP_BREWFILE ALLEYUUP_REPO_SYNC ALLEYUUP_SHELL ALLEYUUP_MACOS
  ALLEYUUP_MACOS_MAJOR ALLEYUUP_MACOS_CHECK_HOURS ALLEYUUP_REPO_DIR
  ALLEYUUP_DRY_RUN ALLEYUUP_NOTIFY ALLEYUUP_LOG
)
ALLEYUUP_ENV_NAMES=()
ALLEYUUP_ENV_VALUES=()
