: "${ALLEYUUP_BREW_GREEDY:=1}"
: "${ALLEYUUP_BREW_CLEANUP:=1}"
: "${ALLEYUUP_MAS:=1}"
: "${ALLEYUUP_AGY:=1}"
: "${ALLEYUUP_CLAUDE:=1}"
: "${ALLEYUUP_OPENCODE_STANDALONE:=1}"
: "${ALLEYUUP_OPENCLAW:=1}"
: "${ALLEYUUP_NVM:=1}"
