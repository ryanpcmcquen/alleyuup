ALLEYUUP_CASK_IGNORE=()
ALLEYUUP_NPM_IGNORE=()
ALLEYUUP_REPO_IGNORE=()

FAILED_STEPS=()
NON_DEFAULT_REPOS=()
REPO_PULL_ERRORS=()
CLEANUP_PATHS=()

LOCK_DIR="${ALLEYUUP_LOCK_DIR:-${TMPDIR:-/tmp}/alleyuup.lock}"
LOCK_HELD=0

MACHINE_REPO_LOADED=0
MACHINE_REPO_CACHE=""

resolve_self_repo() {
  local source="${BASH_SOURCE[0]}"
  while [[ -L "$source" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  local candidate
  candidate="$(cd -P "$(dirname "$source")" && pwd)"
  if [[ -d "$candidate/.git" ]]; then
    printf "%s\n" "$candidate"
    return 0
  fi
  return 1
}

_resolve_machine_repo() {
  if [[ -n "${ALLEYUUP_REPO_DIR:-}" ]]; then
    local expanded="${ALLEYUUP_REPO_DIR/#\~/$HOME}"
    if [[ -d "$expanded" ]]; then
      printf "%s\n" "$expanded"
      return 0
    fi
  fi
  if [[ -f "$REPO_CONFIG_FILE" ]]; then
    local saved
    saved="$(head -n 1 "$REPO_CONFIG_FILE" | tr -d '\r\n')"
    if [[ -n "$saved" ]] && [[ -d "$saved" ]]; then
      printf "%s\n" "$saved"
      return 0
    fi
  fi
  return 1
}

# Memoized: resolve the machine repo path at most once per run
get_machine_repo() {
  if (( MACHINE_REPO_LOADED == 0 )); then
    MACHINE_REPO_CACHE="$(_resolve_machine_repo 2>/dev/null || true)"
    MACHINE_REPO_LOADED=1
  fi
  [[ -n "$MACHINE_REPO_CACHE" ]] || return 1
  printf "%s\n" "$MACHINE_REPO_CACHE"
}

invalidate_machine_repo_cache() {
  MACHINE_REPO_LOADED=0
  MACHINE_REPO_CACHE=""
}

configure_machine_repo() {
  local input="${1:-}"
  if command -v dots >/dev/null 2>&1; then
    dots repo "$input"
    sync_machine_repo
    return $?
  fi

  if [[ -z "$input" ]]; then
    printf "\n${BOLD}${BLUE}==> Configure Machine Config / Brewfile Repository${RESET}\n"
    printf "Specify how to track configs & Brewfile on this machine:\n"
    printf "  - Enter a ${BOLD}local directory path${RESET} (e.g. ~/code/my-dots)\n"
    printf "  - Enter a ${BOLD}Gist ID or Git URL${RESET} to clone into ~/code/\n"
    printf "  - Enter ${BOLD}new${RESET} to create & clone a new private GitHub Gist for this machine\n\n"
    read -r -p "Repo path, Gist ID/URL, or 'new': " input
  fi

  input="${input#"${input%%[![:space:]]*}"}"
  input="${input%"${input##*[![:space:]]}"}"
  if [[ -z "$input" ]]; then
    printf "${RED}Aborted: no repository specified.${RESET}\n" >&2
    exit 1
  fi

  local target_dir=""
  if [[ "$input" == "new" ]]; then
    if ! command -v gh >/dev/null 2>&1; then
      printf "${RED}'gh' CLI is required to create a new Gist automatically.${RESET}\n" >&2
      exit 1
    fi
    local host tmp_dir gist_url gist_id
    host="$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo "mac")"
    tmp_dir="$(mktemp -d)"
    printf "# Local Configs (%s)\n" "$host" > "$tmp_dir/README.md"
    printf "${BLUE}==> Creating new private Gist for %s...${RESET}\n" "$host"
    gist_url="$(gh gist create "$tmp_dir/README.md" --desc "Local configs ($host)" | tail -n 1)"
    rm -rf "$tmp_dir"
    gist_id="${gist_url##*/}"
    target_dir="$HOME/code/$gist_id"
    mkdir -p "$HOME/code"
    git clone "git@gist.github.com:${gist_id}.git" "$target_dir" 2>/dev/null || git clone "https://gist.github.com/${gist_id}.git" "$target_dir"
  elif [[ "$input" =~ ^[0-9a-fA-F]{20,40}$ ]]; then
    target_dir="$HOME/code/$input"
    if [[ ! -d "$target_dir/.git" ]]; then
      mkdir -p "$HOME/code"
      printf "${BLUE}==> Cloning Gist %s into %s...${RESET}\n" "$input" "$target_dir"
      git clone "git@gist.github.com:${input}.git" "$target_dir" 2>/dev/null || git clone "https://gist.github.com/${input}.git" "$target_dir"
    fi
  elif [[ "$input" =~ ^(git@|https?://|ssh://) ]]; then
    local base
    base="$(basename "$input" .git)"
    target_dir="$HOME/code/$base"
    if [[ ! -d "$target_dir/.git" ]]; then
      mkdir -p "$HOME/code"
      printf "${BLUE}==> Cloning %s into %s...${RESET}\n" "$input" "$target_dir"
      git clone "$input" "$target_dir"
    fi
  else
    target_dir="${input/#\~/$HOME}"
    mkdir -p "$target_dir"
    target_dir="$(cd -P "$target_dir" && pwd)"
    if [[ ! -d "$target_dir/.git" ]]; then
      printf "${BLUE}==> Initializing new Git repository in %s...${RESET}\n" "$target_dir"
      git -C "$target_dir" init -b main
    fi
  fi

  mkdir -p "$(dirname "$REPO_CONFIG_FILE")"
  printf "%s\n" "$target_dir" > "$REPO_CONFIG_FILE"
  invalidate_machine_repo_cache
  printf "${GREEN}✓ Saved machine config repo:${RESET} %s (stored in %s)\n" "$target_dir" "$REPO_CONFIG_FILE"
  sync_machine_repo
}

get_version_string() {
  local repo
  if repo="$(resolve_self_repo 2>/dev/null)"; then
    local sha count dirty=""
    sha="$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
    count="$(git -C "$repo" rev-list --count HEAD 2>/dev/null || echo "0")"
    if [[ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]]; then
      dirty="-dirty"
    fi
    printf "%s (r%s, %s%s)" "$ALLEYUUP_VERSION" "$count" "$sha" "$dirty"
  else
    printf "%s (standalone)" "$ALLEYUUP_VERSION"
  fi
}

check_version_status() {
  local ver
  ver="$(get_version_string)"
  printf "alleyuup v%s\n" "$ver"

  local repo
  if repo="$(resolve_self_repo 2>/dev/null)" && git -C "$repo" remote get-url origin >/dev/null 2>&1; then
    local branch local_sha remote_sha
    branch="$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || echo "main")"
    local_sha="$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo "")"
    remote_sha="$(git -C "$repo" ls-remote origin "refs/heads/$branch" 2>/dev/null | awk '{print $1}')"
    if [[ -n "$remote_sha" ]]; then
      if [[ "$local_sha" == "$remote_sha" ]]; then
        printf "${GREEN}✓ Up to date with remote (%s)${RESET}\n" "${remote_sha:0:7}"
      else
        printf "${YELLOW}⚠ Update available on remote: %s -> %s (run 'alleyuup' or 'dots pull')${RESET}\n" "${local_sha:0:7}" "${remote_sha:0:7}"
      fi
    fi
  elif command -v curl >/dev/null 2>&1; then
    local remote_ver
    remote_ver="$(curl -fsSL "${TOOLS_RAW_BASE}/alleyuup?$(date +%s)" 2>/dev/null | awk -F'"' '/^ALLEYUUP_VERSION=/{print $2; exit}')"
    if [[ -n "$remote_ver" ]]; then
      if [[ "$remote_ver" == "$ALLEYUUP_VERSION" ]]; then
        printf "${GREEN}✓ Up to date with remote (v%s)${RESET}\n" "$remote_ver"
      else
        printf "${YELLOW}⚠ Update available on remote: v%s -> v%s (run 'alleyuup')${RESET}\n" "$ALLEYUUP_VERSION" "$remote_ver"
      fi
    fi
  fi
}

write_default_config() {
  local file="$1"
  mkdir -p "$(dirname "$file")"
  cat <<'EOF' > "$file"
# alleyuup per-machine configuration
# Tracked via `dots` (symlinked from ~/.config/alleyuup/config -> <machine-gist>/alleyuup.conf)
#
# Set any step to 0 to disable it on this machine if something is broken or unwanted.

ALLEYUUP_SELF_UPDATE=1          # Pull latest alleyuup & dots from the tools Gist
ALLEYUUP_BREW=1                 # Run Homebrew updates
ALLEYUUP_BREW_FORMULA=1         # Upgrade Homebrew formulas
ALLEYUUP_BREW_CASK=1            # Upgrade Homebrew casks
ALLEYUUP_BREW_GREEDY=1          # Pass --greedy when upgrading casks
ALLEYUUP_BREW_CLEANUP=1         # Run brew cleanup --prune=all
ALLEYUUP_MAS=1                  # Upgrade Mac App Store apps via mas
ALLEYUUP_AGY=1                  # Upgrade Antigravity CLI (agy)
ALLEYUUP_CLAUDE=1               # Upgrade Claude Code CLI (claude update)
ALLEYUUP_OPENCODE_STANDALONE=1  # Upgrade standalone ~/.opencode/bin/opencode (if present)
ALLEYUUP_OPENCLAW=1             # Upgrade OpenClaw CLI (if not app-managed)
ALLEYUUP_NVM=1                  # Run 'nvm install --lts' if npm is missing and nvm is installed
ALLEYUUP_NPM=1                  # Upgrade global npm packages (skips local file: links)
ALLEYUUP_PNPM=1                 # Upgrade global pnpm packages
ALLEYUUP_RUSTUP=1               # Upgrade Rust toolchains via rustup
ALLEYUUP_UV=1                   # Upgrade uv tools
ALLEYUUP_PIPX=1                 # Upgrade pipx packages
ALLEYUUP_GH_EXT=1               # Upgrade GitHub CLI extensions
ALLEYUUP_CODE_REPOS=1           # Walk git repos in ALLEYUUP_CODE_DIR, pull, and report branches
ALLEYUUP_CODE_DIR="$HOME/code"  # Directory to scan for git repositories
ALLEYUUP_JOBS=6                 # Max parallel git pulls at once
ALLEYUUP_NET_TIMEOUT=180        # Hard limit (seconds) for each network git operation
ALLEYUUP_LOCK_MAX_HOURS=6       # Reclaim the run lock if it is older than this
ALLEYUUP_FLINT=1                # Rebuild & install flint when its sources change
ALLEYUUP_SCRIBE=1               # Rebuild & install scribe when its sources change
ALLEYUUP_REPO_DIR=""            # Optional path to this machine's config/Brewfile git repo
ALLEYUUP_BREWFILE=1             # Refresh tracked Brewfile in machine config repo
ALLEYUUP_REPO_SYNC=1            # Collect local configs, commit, and push to machine config repo
ALLEYUUP_SHELL=1                # Update Fisher plugins and Fish completions
ALLEYUUP_MACOS=1                # Run macOS software updates (minor/patch & security updates)
ALLEYUUP_MACOS_MAJOR=0          # Allow major macOS version upgrades (0 = block major OS upgrades)
ALLEYUUP_MACOS_CHECK_HOURS=24   # Reuse the macOS update scan for this many hours (0 = always rescan)
ALLEYUUP_NOTIFY=0               # macOS notification when an unattended run fails

# Default branches when checking git repos in ALLEYUUP_CODE_DIR:
ALLEYUUP_DEFAULT_BRANCHES=("main" "master" "dev" "staging")

# Package & repo exclusion lists (space-separated inside parentheses)
# Useful when a specific formula, cask, npm package, or git repo is broken on this machine:
ALLEYUUP_BREW_IGNORE=()
ALLEYUUP_CASK_IGNORE=()
ALLEYUUP_NPM_IGNORE=()
ALLEYUUP_REPO_IGNORE=()

# Optional hook functions (uncomment to override or extend behavior on this machine):
#
# alleyuup_before() {
#   # Commands to run before standard upgrade steps
#   :
# }
#
# alleyuup_after() {
#   # Commands to run after standard upgrade steps
#   :
# }

# Optional: tee output to a log file (uncomment to enable)
# ALLEYUUP_LOG="$HOME/Library/Logs/alleyuup.log"
EOF
}

usage() {
  local self_repo="(standalone)"
  if self_repo="$(resolve_self_repo 2>/dev/null)"; then
    :
  fi
  local machine_repo="(not configured; run 'alleyuup --repo')"
  if machine_repo="$(get_machine_repo 2>/dev/null)"; then
    :
  fi
  cat <<EOF
Usage: alleyuup [options]

Upgrade local packages, casks, App Store apps, CLI tools, git repos, and macOS software.
  Tools repo:   $self_repo
  Machine repo: $machine_repo
  Local config: $CONFIG_FILE

Options:
  --no-macos, --fast   Skip macOS system software updates (softwareupdate)
  --no-repos           Skip pulling git repositories in ~/code
  --no-self-update     Skip pulling latest alleyuup & dots from the tools Gist
  --dry-run, -n        Report what would change without changing anything
  --only <steps>       Run only the listed steps (comma-separated)
  --skip <steps>       Skip the listed steps (comma-separated)
  --repo [target]      Configure this machine's config/Brewfile repo (path, Gist ID/URL, or 'new')
  --config, --edit     Open $CONFIG_FILE in \$EDITOR (creates default if missing)
  --init-config        Create $CONFIG_FILE with defaults (no editor)
  --print-config       Print the path and contents of $CONFIG_FILE
  --print-steps        Print resolved step toggles and exit
  --print-mappings     Print tracked config file mappings and exit
  --print-sensitive-patterns  Print paths that must never be tracked and exit
  --check              Check version and whether a newer version is available on remote
  -v, --version        Print alleyuup version and git revision
  -h, --help           Show this help message

Steps for --only/--skip:
  ${ALLEYUUP_STEP_KEYS[*]}
EOF
}

# Load per-machine config file before parsing CLI flags so flags take precedence
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

# Re-apply environment overrides so env beats the config file
if (( ${#ALLEYUUP_ENV_NAMES[@]} > 0 )); then
  for ((_alleyuup_i = 0; _alleyuup_i < ${#ALLEYUUP_ENV_NAMES[@]}; _alleyuup_i++)); do
    printf -v "${ALLEYUUP_ENV_NAMES[$_alleyuup_i]}" '%s' "${ALLEYUUP_ENV_VALUES[$_alleyuup_i]}"
  done
  unset _alleyuup_i
fi

ORIG_ARGS=("$@")
CONFIGURE_REPO_TARGET=""
RUN_CONFIGURE_REPO=0
ONLY_STEPS=""
SKIP_STEPS=""
PRINT_STEPS=0
PRINT_MAPPINGS=0
PRINT_SENSITIVE=0
while (( $# > 0 )); do
  arg="$1"
  shift
  case "$arg" in
    --no-macos|--fast)
      ALLEYUUP_MACOS=0
      ;;
    --no-repos)
      ALLEYUUP_CODE_REPOS=0
      ;;
    --no-self-update)
      ALLEYUUP_SELF_UPDATE=0
      ;;
    --dry-run|-n)
      ALLEYUUP_DRY_RUN=1
      ;;
    --only)
      ONLY_STEPS="${1:-}"
      (( $# > 0 )) && shift
      ;;
    --only=*)
      ONLY_STEPS="${arg#--only=}"
      ;;
    --skip)
      SKIP_STEPS="${1:-}"
      (( $# > 0 )) && shift
      ;;
    --skip=*)
      SKIP_STEPS="${arg#--skip=}"
      ;;
    --print-steps)
      PRINT_STEPS=1
      ;;
    --print-mappings)
      PRINT_MAPPINGS=1
      ;;
    --print-sensitive-patterns)
      PRINT_SENSITIVE=1
      ;;
    --repo)
      RUN_CONFIGURE_REPO=1
      if (( $# > 0 )) && [[ "$1" != -* ]]; then
        CONFIGURE_REPO_TARGET="$1"
        shift
      fi
      ;;
    --repo=*)
      RUN_CONFIGURE_REPO=1
      CONFIGURE_REPO_TARGET="${arg#--repo=}"
      ;;
    --config|--edit)
      if [[ ! -f "$CONFIG_FILE" ]]; then
        write_default_config "$CONFIG_FILE"
        printf "${GREEN}✓ Created default config at %s${RESET}\n" "$CONFIG_FILE"
      fi
      ${EDITOR:-vi} "$CONFIG_FILE"
      exit 0
      ;;
    --init-config)
      if [[ -f "$CONFIG_FILE" ]]; then
        printf "Config already exists: %s\n" "$CONFIG_FILE"
      else
        write_default_config "$CONFIG_FILE"
        printf "${GREEN}✓ Created default config at %s${RESET}\n" "$CONFIG_FILE"
      fi
      exit 0
      ;;
    --print-config)
      printf "${BLUE}# %s${RESET}\n" "$CONFIG_FILE"
      if [[ -f "$CONFIG_FILE" ]]; then
        cat "$CONFIG_FILE"
      else
        printf "(No config file found at %s; run 'alleyuup --config' to create one)\n" "$CONFIG_FILE"
      fi
      exit 0
      ;;
    -v|--version)
      printf "alleyuup v%s\n" "$(get_version_string)"
      exit 0
      ;;
    --check)
      check_version_status
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf "${RED}Unknown option: %s${RESET}\n\n" "$arg" >&2
      usage >&2
      exit 1
      ;;
  esac
done

section() {
  printf "\n${BLUE}==> %s${RESET}\n" "$1"
}

run_step() {
  local name="$1"
  shift
  section "$name"
  if "$@"; then
    printf "${GREEN}✓ %s complete${RESET}\n" "$name"
  else
    local status=$?
    printf "${YELLOW}⚠ %s exited with status %d${RESET}\n" "$name" "$status" >&2
    FAILED_STEPS+=("$name")
  fi
}

# Run a mutating step, or just report it when --dry-run is active
run_or_plan() {
  local name="$1"
  shift
  if is_dry_run; then
    section "$name"
    printf "Would run: %s\n" "$*"
    return 0
  fi
  run_step "$name" "$@"
}

# Run a command into a temp log, to be shown only if it fails.
# Sets RUN_LOG to the log path; caller must clear it (print_run_log or rm).
run_logged() {
  RUN_LOG="$(mktemp "${TMPDIR:-/tmp}/alleyuup-cmd.XXXXXX")" || {
    RUN_LOG=""
    return 1
  }
  if "$@" > "$RUN_LOG" 2>&1; then
    return 0
  fi
  return 1
}

# Print and remove the log captured by run_logged
print_run_log() {
  if [[ -n "${RUN_LOG:-}" ]] && [[ -s "$RUN_LOG" ]]; then
    sed 's/^/      /' "$RUN_LOG"
  fi
  [[ -n "${RUN_LOG:-}" ]] && rm -f "$RUN_LOG"
  RUN_LOG=""
}

clear_run_log() {
  [[ -n "${RUN_LOG:-}" ]] && rm -f "$RUN_LOG"
  RUN_LOG=""
}

in_array() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

acquire_lock() {
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    write_lock_files
    LOCK_HELD=1
    return 0
  fi

  local holder=""
  if [[ -f "$LOCK_DIR/pid" ]]; then
    holder="$(head -n 1 "$LOCK_DIR/pid" 2>/dev/null | tr -d '\r\n' || true)"
  fi

  if [[ -n "$holder" ]] && kill -0 "$holder" 2>/dev/null; then
    local max_hours="${ALLEYUUP_LOCK_MAX_HOURS:-6}"
    local age=""
    age="$(lock_age_seconds)"
    if [[ "$max_hours" =~ ^[0-9]+$ ]] && (( max_hours > 0 )) && [[ "$age" =~ ^[0-9]+$ ]] && (( age > max_hours * 3600 )); then
      printf "${YELLOW}⚠ Stale lock held by pid %s for %dh; taking over.${RESET}\n" "$holder" "$((age / 3600))"
    else
      printf "${YELLOW}⚠ alleyuup is already running (pid %s, %dm); skipping this run.${RESET}\n" "$holder" "$(( ${age:-0} / 60 ))"
      return 1
    fi
  fi

  # Release a stale lock (dead pid, or exceeded the max age) and retry
  rm -rf "$LOCK_DIR"
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    write_lock_files
    LOCK_HELD=1
    return 0
  fi

  printf "${YELLOW}⚠ Could not acquire lock %s; skipping this run.${RESET}\n" "$LOCK_DIR"
  return 1
}

release_lock() {
  if (( LOCK_HELD == 1 )); then
    rm -rf "$LOCK_DIR"
    LOCK_HELD=0
  fi
}

write_lock_files() {
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
  printf '%s\n' "$(date +%s)" > "$LOCK_DIR/started"
}

lock_age_seconds() {
  local started="" mtime=""
  if [[ -f "$LOCK_DIR/started" ]]; then
    started="$(head -n 1 "$LOCK_DIR/started" 2>/dev/null | tr -d '\r\n' || true)"
  fi
  if [[ "$started" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$(( $(date +%s) - started ))"
    return 0
  fi
  mtime="$(stat -f %m "$LOCK_DIR" 2>/dev/null || true)"
  if [[ "$mtime" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$(( $(date +%s) - mtime ))"
    return 0
  fi
  printf '0\n'
}

# Run a command under a hard wall-clock limit (perl ships with macOS)
run_with_timeout() {
  local seconds="$1"
  shift
  if command -v perl >/dev/null 2>&1; then
    perl -e 'alarm shift; exec @ARGV' "$seconds" "$@"
  else
    "$@"
  fi
}

cleanup() {
  release_lock
  if (( ${#CLEANUP_PATHS[@]} > 0 )); then
    rm -rf "${CLEANUP_PATHS[@]}" 2>/dev/null || true
  fi
}

trap cleanup EXIT INT TERM

step_var_for() {
  case "$1" in
    self-update|selfupdate|self) printf 'ALLEYUUP_SELF_UPDATE\n' ;;
    brew) printf 'ALLEYUUP_BREW\n' ;;
    mas|app-store) printf 'ALLEYUUP_MAS\n' ;;
    agy|antigravity) printf 'ALLEYUUP_AGY\n' ;;
    claude) printf 'ALLEYUUP_CLAUDE\n' ;;
    opencode) printf 'ALLEYUUP_OPENCODE_STANDALONE\n' ;;
    openclaw) printf 'ALLEYUUP_OPENCLAW\n' ;;
    nvm) printf 'ALLEYUUP_NVM\n' ;;
    npm) printf 'ALLEYUUP_NPM\n' ;;
    pnpm) printf 'ALLEYUUP_PNPM\n' ;;
    rustup|rust) printf 'ALLEYUUP_RUSTUP\n' ;;
    uv) printf 'ALLEYUUP_UV\n' ;;
    pipx) printf 'ALLEYUUP_PIPX\n' ;;
    gh-ext|gh) printf 'ALLEYUUP_GH_EXT\n' ;;
    repos) printf 'ALLEYUUP_CODE_REPOS\n' ;;
    flint) printf 'ALLEYUUP_FLINT\n' ;;
    scribe) printf 'ALLEYUUP_SCRIBE\n' ;;
    brewfile) printf 'ALLEYUUP_BREWFILE\n' ;;
    repo-sync|configs) printf 'ALLEYUUP_REPO_SYNC\n' ;;
    shell) printf 'ALLEYUUP_SHELL\n' ;;
    macos|os) printf 'ALLEYUUP_MACOS\n' ;;
    *) return 1 ;;
  esac
}

# Set a step (or a group like local-projects) on or off
set_step_state() {
  local key="$1" value="$2" var
  case "$key" in
    local-projects)
      printf -v ALLEYUUP_FLINT '%s' "$value"
      printf -v ALLEYUUP_SCRIBE '%s' "$value"
      ;;
    *)
      if ! var="$(step_var_for "$key")"; then
        return 1
      fi
      printf -v "$var" '%s' "$value"
      ;;
  esac
  return 0
}

apply_step_filters() {
  local key var list
  if [[ -n "${ONLY_STEPS:-}" ]]; then
    for var in "${ALLEYUUP_STEP_VARS[@]}"; do
      printf -v "$var" '%s' 0
    done
    list="${ONLY_STEPS// /}"
    local IFS=','
    for key in $list; do
      [[ -z "$key" ]] && continue
      if ! set_step_state "$key" 1; then
        printf "${RED}Unknown step for --only: %s${RESET}\n" "$key" >&2
        printf "Valid steps: %s\n" "${ALLEYUUP_STEP_KEYS[*]}" >&2
        return 1
      fi
    done
  fi

  if [[ -n "${SKIP_STEPS:-}" ]]; then
    list="${SKIP_STEPS// /}"
    local IFS=','
    for key in $list; do
      [[ -z "$key" ]] && continue
      if ! set_step_state "$key" 0; then
        printf "${RED}Unknown step for --skip: %s${RESET}\n" "$key" >&2
        printf "Valid steps: %s\n" "${ALLEYUUP_STEP_KEYS[*]}" >&2
        return 1
      fi
    done
  fi
  return 0
}

print_steps() {
  local var
  for var in "${ALLEYUUP_STEP_VARS[@]}"; do
    printf '%s=%s\n' "$var" "${!var}"
  done
  printf 'ALLEYUUP_DRY_RUN=%s\n' "$ALLEYUUP_DRY_RUN"
}

print_mappings() {
  local entry
  for entry in "${ALLEYUUP_CONFIG_MAPPINGS[@]}"; do
    printf '%s\n' "$entry"
  done
}

print_sensitive_patterns() {
  local p
  for p in "${ALLEYUUP_SENSITIVE_PATTERNS[@]}"; do
    printf '%s\n' "$p"
  done
}

# True when a path looks like it holds credentials and must not be tracked
is_sensitive_path() {
  local path="$1" p
  for p in "${ALLEYUUP_SENSITIVE_PATTERNS[@]}"; do
    if [[ "$path" == *"$p"* ]]; then
      return 0
    fi
  done
  return 1
}

rotate_log() {
  local log_file="$1"
  local max_bytes=$((5 * 1024 * 1024))
  [[ -f "$log_file" ]] || return 0
  local size
  size="$(wc -c < "$log_file" 2>/dev/null | tr -d ' ')"
  [[ "$size" =~ ^[0-9]+$ ]] || return 0
  if (( size > max_bytes )); then
    tail -n 500 "$log_file" > "$log_file.tmp" 2>/dev/null && mv "$log_file.tmp" "$log_file"
  fi
}

start_logging() {
  [[ -n "${ALLEYUUP_LOG:-}" ]] || return 0
  local log_file="$ALLEYUUP_LOG"
  if [[ "$log_file" == "1" ]]; then
    log_file="$HOME/Library/Logs/alleyuup.log"
  fi
  log_file="${log_file/#\~/$HOME}"
  mkdir -p "$(dirname "$log_file")" 2>/dev/null || return 0
  rotate_log "$log_file"
  printf '\n===== alleyuup %s (%s) =====\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$(date '+%Z')" >> "$log_file"
  exec > >(tee -a "$log_file") 2>&1
}

is_dry_run() {
  (( ALLEYUUP_DRY_RUN == 1 ))
}

# Post a macOS notification (used by unattended scheduled runs)
notify() {
  (( ALLEYUUP_NOTIFY == 1 )) || return 0
  command -v osascript >/dev/null 2>&1 || return 0
  local title="$1"
  local message="$2"
  message="${message//\"/}"
  osascript -e "display notification \"$message\" with title \"$title\"" >/dev/null 2>&1 || true
}

# Verify a command exists AND is not a broken '#!/usr/bin/env node' wrapper on a machine without node
has_working_cmd() {
  local cmd="$1"
  local bin_path
  bin_path="$(command -v "$cmd" 2>/dev/null || true)"
  [[ -z "$bin_path" ]] && return 1
  if ! command -v node >/dev/null 2>&1 && [[ -f "$bin_path" ]]; then
    local first_line
    IFS= read -r first_line < "$bin_path" 2>/dev/null || true
    if [[ "$first_line" == "#!"*node* ]]; then
      return 1
    fi
  fi
  return 0
}

self_update_tools() {
  local repo
  if repo="$(resolve_self_repo)"; then
    if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
      if [[ -z "$(git -C "$repo" status --porcelain 2>/dev/null)" ]]; then
        local branch before_sha after_sha
        branch="$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || echo "main")"
        before_sha="$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo "")"
        if ! run_with_timeout 120 git -C "$repo" pull --rebase --quiet origin "$branch" 2>/dev/null; then
          # Fallback to HTTPS pull if SSH isn't configured on this machine
          run_with_timeout 120 git -C "$repo" pull --rebase --quiet "https://gist.github.com/${TOOLS_GIST_ID}.git" "$branch"
        fi
        after_sha="$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo "")"
        if [[ -n "$before_sha" ]] && [[ "$before_sha" != "$after_sha" ]]; then
          printf "Updated alleyuup & dots (%s -> %s); restarting alleyuup with new version...\n" "${before_sha:0:7}" "${after_sha:0:7}"
          release_lock
          if (( ${#ORIG_ARGS[@]} > 0 )); then
            exec "$0" --no-self-update "${ORIG_ARGS[@]}"
          else
            exec "$0" --no-self-update
          fi
        else
          printf "alleyuup & dots are already up to date (%s).\n" "${after_sha:0:7}"
        fi
      else
        printf "Tools repo (%s) has local uncommitted changes; skipping pull.\n" "$repo"
      fi
    fi
    return 0
  fi

  # Standalone fallback: self-update directly via curl if not inside a git clone
  if command -v curl >/dev/null 2>&1; then
    local self_path="${BASH_SOURCE[0]}"
    local tmp_file="${self_path}.tmp.$$"
    if curl -fsSL "${TOOLS_RAW_BASE}/alleyuup?$(date +%s)" -o "$tmp_file" 2>/dev/null && bash -n "$tmp_file" 2>/dev/null; then
      if ! cmp -s "$tmp_file" "$self_path"; then
        chmod +x "$tmp_file"
        mv "$tmp_file" "$self_path"
        local new_ver
        new_ver="$(awk -F'"' '/^ALLEYUUP_VERSION=/{print $2; exit}' "$self_path")"
        printf "Updated standalone alleyuup to v%s; restarting alleyuup with new version...\n" "${new_ver:-latest}"
        release_lock
        if (( ${#ORIG_ARGS[@]} > 0 )); then
          exec "$self_path" --no-self-update "${ORIG_ARGS[@]}"
        else
          exec "$self_path" --no-self-update
        fi
      else
        rm -f "$tmp_file"
        printf "Standalone alleyuup is already up to date (v%s).\n" "$ALLEYUUP_VERSION"
      fi
    else
      rm -f "$tmp_file"
      printf "Could not fetch standalone update from Gist.\n"
      return 1
    fi
  fi
}

update_homebrew() {
  if ! is_dry_run; then
    brew update
  fi

  if (( ALLEYUUP_BREW_FORMULA == 1 )); then
    local formulas=()
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      if (( ${#ALLEYUUP_BREW_IGNORE[@]} > 0 )) && in_array "$f" "${ALLEYUUP_BREW_IGNORE[@]}"; then
        printf "Skipping ignored formula: %s\n" "$f"
      else
        formulas+=("$f")
      fi
    done < <(brew outdated --formula --quiet)
    if (( ${#formulas[@]} > 0 )); then
      if is_dry_run; then
        printf "Would upgrade formulas: %s\n" "${formulas[*]}"
      else
        brew upgrade --formula --no-ask "${formulas[@]}"
      fi
    else
      printf "All Homebrew formulas are up to date.\n"
    fi
  fi

  if (( ALLEYUUP_BREW_CASK == 1 )); then
    local casks=()
    local out_cmd=(brew outdated --cask --quiet)
    (( ALLEYUUP_BREW_GREEDY == 1 )) && out_cmd=(brew outdated --cask --greedy --quiet)
    while IFS= read -r c; do
      [[ -z "$c" ]] && continue
      if (( ${#ALLEYUUP_CASK_IGNORE[@]} > 0 )) && in_array "$c" "${ALLEYUUP_CASK_IGNORE[@]}"; then
        printf "Skipping ignored cask: %s\n" "$c"
      else
        casks+=("$c")
      fi
    done < <("${out_cmd[@]}")
    if (( ${#casks[@]} > 0 )); then
      if is_dry_run; then
        printf "Would upgrade casks: %s\n" "${casks[*]}"
      elif (( ALLEYUUP_BREW_GREEDY == 1 )); then
        brew upgrade --cask --greedy --no-ask "${casks[@]}"
      else
        brew upgrade --cask --no-ask "${casks[@]}"
      fi
    else
      printf "All Homebrew casks are up to date.\n"
    fi
  fi

  if (( ALLEYUUP_BREW_CLEANUP == 1 )); then
    if is_dry_run; then
      printf "Would run: brew cleanup --prune=all\n"
    else
      brew cleanup --prune=all
    fi
  fi
}

ensure_node_via_nvm() {
  if ! has_working_cmd npm; then
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    if [[ -s "$NVM_DIR/nvm.sh" ]]; then
      # shellcheck disable=SC1091
      source "$NVM_DIR/nvm.sh"
    fi
    if command -v nvm >/dev/null 2>&1; then
      run_or_plan "Node LTS via nvm" nvm install --lts
    fi
  fi
}

# Parse `npm outdated -g --parseable` output into package names.
# Fields: <path>:<name>@<current>:<name>@<wanted>:<name>@<latest>:<location>
# Skips symlinked local packages and packages already at the wanted version.
parse_npm_outdated() {
  local line pkg_path rest current wanted pkg
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    pkg_path="${line%%:*}"
    if [[ -L "$pkg_path" ]]; then
      continue
    fi
    rest="${line#*:}"
    current="${rest%%:*}"
    rest="${rest#*:}"
    wanted="${rest%%:*}"
    if [[ "$current" == "$wanted" ]]; then
      continue
    fi
    pkg="${current%@*}"
    [[ -z "$pkg" ]] && continue
    printf '%s\n' "$pkg"
  done
}

update_npm_globals() {
  local pkgs=()
  local outdated_out
  outdated_out="$(npm outdated -g --parseable 2>/dev/null || true)"

  local pkg
  while IFS= read -r pkg; do
    [[ -z "$pkg" ]] && continue
    if (( ${#ALLEYUUP_NPM_IGNORE[@]} > 0 )) && in_array "$pkg" "${ALLEYUUP_NPM_IGNORE[@]}"; then
      printf "Skipping ignored global npm package: %s\n" "$pkg"
      continue
    fi
    pkgs+=("$pkg")
  done < <(printf '%s\n' "$outdated_out" | parse_npm_outdated)

  if (( ${#pkgs[@]} > 0 )); then
    if is_dry_run; then
      printf "Would update global npm packages: %s\n" "${pkgs[*]}"
    else
      printf "Updating outdated global npm packages: %s\n" "${pkgs[*]}"
      npm install -g --loglevel=error --no-audit --no-fund --yes "${pkgs[@]/%/@latest}"
    fi
  else
    printf "All global npm packages are up to date.\n"
  fi
}

run_repo_pull() {
  local dir="$1"
  local out="$2"
  local before="" after="" pull_out="" status=0

  if is_dry_run; then
    if run_with_timeout "${ALLEYUUP_NET_TIMEOUT:-180}" git -C "$dir" fetch --all --quiet 2>/dev/null; then
      local behind=0
      behind="$(git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
      printf 'DRY\t%s\t\n' "$behind" > "$out"
    else
      status=$?
      printf 'FAIL\t%s\n' "$status" > "$out"
    fi
    return 0
  fi

  before="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo "")"

  if pull_out="$(run_with_timeout "${ALLEYUUP_NET_TIMEOUT:-180}" git -C "$dir" pull --all --quiet 2>&1)"; then
    after="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo "")"
    printf 'OK\t%s\t%s\n' "$before" "$after" > "$out"
  else
    status=$?
    printf 'FAIL\t%s\n' "$status" > "$out"
    if [[ -n "$pull_out" ]]; then
      printf '%s\n' "$pull_out" > "$out.detail"
    fi
  fi
}

update_code_repos() {
  if [[ ! -d "$ALLEYUUP_CODE_DIR" ]]; then
    printf "Directory %s does not exist; skipping.\n" "$ALLEYUUP_CODE_DIR"
    return 0
  fi

  local self_repo="" machine_repo=""
  self_repo="$(resolve_self_repo 2>/dev/null || true)"
  machine_repo="$(get_machine_repo 2>/dev/null || true)"

  local work_dir
  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/alleyuup-repos.XXXXXX")" || {
    printf "Could not create temp dir; skipping repository pulls.\n"
    return 0
  }
  CLEANUP_PATHS+=("$work_dir")

  local idx=0 dir
  while IFS= read -r dir; do
    [[ -z "$dir" ]] && continue
    if ! git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
      continue
    fi
    if [[ -n "$(git -C "$dir" rev-parse --show-prefix 2>/dev/null)" ]]; then
      continue
    fi

    # Skip the shared tools Gist and machine config Gist (managed in dedicated steps)
    local abs_dir
    abs_dir="$(cd -P "$dir" 2>/dev/null && pwd || echo "$dir")"
    if [[ -n "$self_repo" && "$abs_dir" == "$self_repo" ]] || [[ -n "$machine_repo" && "$abs_dir" == "$machine_repo" ]]; then
      continue
    fi

    local repo_name current_branch branch_label dirty_count dirty_note=""
    repo_name="$(basename "$dir")"
    current_branch="$(git -C "$dir" branch --show-current 2>/dev/null || echo "")"
    branch_label="[${current_branch:-(detached)}]"
    dirty_count="$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    if (( dirty_count > 0 )); then
      dirty_note=" (${dirty_count} dirty)"
    fi

    local is_default_branch=1
    if [[ -z "$current_branch" ]] || ! in_array "$current_branch" "${ALLEYUUP_DEFAULT_BRANCHES[@]}"; then
      is_default_branch=0
      NON_DEFAULT_REPOS+=("- ${repo_name}: ${current_branch:-(detached)}")
    fi

    # Local (non-network) reasons to skip the pull
    local skip_reason=""
    if (( ${#ALLEYUUP_REPO_IGNORE[@]} > 0 )) && in_array "$repo_name" "${ALLEYUUP_REPO_IGNORE[@]}"; then
      skip_reason="ignored"
    else
      local remotes=""
      remotes="$(git -C "$dir" remote 2>/dev/null || true)"
      if [[ -z "$remotes" ]]; then
        skip_reason="no remote"
      else
        local origin_url=""
        origin_url="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
        if [[ "$origin_url" == /* ]] && [[ ! -e "$origin_url" ]]; then
          skip_reason="missing local remote"
        fi
      fi
    fi

    {
      printf '%s\n' "$repo_name"
      printf '%s\n' "$branch_label"
      printf '%s\n' "$is_default_branch"
      printf '%s\n' "$dirty_note"
      printf '%s\n' "$skip_reason"
    } > "$work_dir/$idx.meta"

    if [[ -z "$skip_reason" ]]; then
      local jobs_cap="${ALLEYUUP_JOBS:-6}"
      [[ "$jobs_cap" =~ ^[0-9]+$ ]] && (( jobs_cap > 0 )) || jobs_cap=6
      while (( $(jobs -pr | wc -l | tr -d ' ') >= jobs_cap )); do
        sleep 0.05
      done
      (
        if [[ -z "${GIT_SSH_COMMAND:-}" ]]; then
          export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=2"
        fi
        export GIT_TERMINAL_PROMPT=0
        run_repo_pull "$dir" "$work_dir/$idx.result"
      ) >/dev/null 2>&1 &
    fi

    idx=$((idx + 1))
  done < <(find "$ALLEYUUP_CODE_DIR" -maxdepth 2 -type d -not -name '.git' | sort)

  if (( idx > 0 )); then
    wait
  fi

  local i repo_name branch_label is_default_branch dirty_note skip_reason
  for (( i = 0; i < idx; i++ )); do
    local meta_file="$work_dir/$i.meta"
    [[ -f "$meta_file" ]] || continue
    {
      IFS= read -r repo_name
      IFS= read -r branch_label
      IFS= read -r is_default_branch
      IFS= read -r dirty_note
      IFS= read -r skip_reason
    } < "$meta_file"

    if [[ -n "$skip_reason" ]]; then
      printf "  - %-22s ${CYAN}%-28s${RESET} skipped (%s)%s\n" "$repo_name" "$branch_label" "$skip_reason" "$dirty_note"
      continue
    fi

    local result_file="$work_dir/$i.result"
    if [[ ! -f "$result_file" ]]; then
      REPO_PULL_ERRORS+=("- ${repo_name} (no result)")
      printf "  ${RED}✗${RESET} %-22s ${CYAN}%-28s${RESET} ${RED}pull did not complete${RESET}%s\n" "$repo_name" "$branch_label" "$dirty_note"
      continue
    fi

    local state="" sha_before="" sha_after=""
    { IFS=$'\t' read -r state sha_before sha_after; } < "$result_file"

    if [[ "$state" == "DRY" ]]; then
      local dry_text="up to date"
      if [[ -n "$sha_before" && "$sha_before" != "0" ]]; then
        dry_text="would pull (${sha_before} behind)"
      fi
      if [[ "$is_default_branch" == "1" ]]; then
        printf "  ${GREEN}✓${RESET} %-22s ${CYAN}%-28s${RESET} %s (dry-run)%s\n" "$repo_name" "$branch_label" "$dry_text" "$dirty_note"
      else
        printf "  ${YELLOW}⚠${RESET} %-22s ${YELLOW}%-28s${RESET} %s (dry-run)%s ${YELLOW}(non-default branch)${RESET}\n" "$repo_name" "$branch_label" "$dry_text" "$dirty_note"
      fi
    elif [[ "$state" == "OK" ]]; then
      local state_text="up to date"
      if [[ -n "$sha_before" && -n "$sha_after" && "$sha_before" != "$sha_after" ]]; then
        state_text="${GREEN}updated (${sha_before} -> ${sha_after})${RESET}"
      fi
      if [[ "$is_default_branch" == "1" ]]; then
        printf "  ${GREEN}✓${RESET} %-22s ${CYAN}%-28s${RESET} %b%s\n" "$repo_name" "$branch_label" "$state_text" "$dirty_note"
      else
        printf "  ${YELLOW}⚠${RESET} %-22s ${YELLOW}%-28s${RESET} %b%s ${YELLOW}(non-default branch)${RESET}\n" "$repo_name" "$branch_label" "$state_text" "$dirty_note"
      fi
    else
      REPO_PULL_ERRORS+=("- ${repo_name} (exit ${sha_before})")
      printf "  ${RED}✗${RESET} %-22s ${CYAN}%-28s${RESET} ${RED}pull failed (exit %s)${RESET}%s\n" "$repo_name" "$branch_label" "$sha_before" "$dirty_note"
      if [[ -f "$result_file.detail" ]]; then
        sed 's/^/      /' "$result_file.detail"
      fi
    fi
  done

  rm -rf "$work_dir"

  printf "\n"
  if (( ${#NON_DEFAULT_REPOS[@]} > 0 )); then
    printf "${YELLOW}Repos not on a default branch:${RESET}\n"
    printf "  %s\n" "${NON_DEFAULT_REPOS[@]}"
    printf "\n"
  fi

  if (( ${#REPO_PULL_ERRORS[@]} > 0 )); then
    printf "${YELLOW}Repo pull errors:${RESET}\n"
    printf "  %s\n" "${REPO_PULL_ERRORS[@]}"
    printf "\n"
    return 1
  fi
}

update_local_projects() {
  local failed=0

  local flint_dir="$ALLEYUUP_CODE_DIR/flint"
  if (( ALLEYUUP_FLINT == 1 )) && [[ -f "$flint_dir/Makefile" ]] && command -v make >/dev/null 2>&1; then
    local need_flint=0 copied_flint=0 flint_msg=""
    if [[ ! -x "$flint_dir/flint" ]] || [[ ! -x "$HOME/bin/flint" ]]; then
      need_flint=1
    elif [[ -n "$(find "$flint_dir/source" "$flint_dir/Makefile" -newer "$flint_dir/flint" 2>/dev/null | head -n 1)" ]]; then
      need_flint=1
    elif ! cmp -s "$flint_dir/flint" "$HOME/bin/flint"; then
      if is_dry_run; then
        flint_msg="would install existing build to ~/bin/flint"
      else
        mkdir -p "$HOME/bin"
        cp -f "$flint_dir/flint" "$HOME/bin/flint"
        copied_flint=1
        flint_msg="installed existing build to ~/bin/flint"
      fi
    fi

    if (( need_flint == 1 )); then
      if is_dry_run; then
        flint_msg="would rebuild and install to ~/bin/flint"
      elif run_logged make -C "$flint_dir" force; then
        clear_run_log
        mkdir -p "$HOME/bin"
        cp -f "$flint_dir/flint" "$HOME/bin/flint"
        flint_msg="rebuilt and installed to ~/bin/flint"
      else
        flint_msg="build failed"
        failed=1
      fi
    elif (( copied_flint == 0 )) && [[ -z "$flint_msg" ]]; then
      flint_msg="up to date"
    fi

    printf "  %-8s %s\n" "flint:" "$flint_msg"
    [[ -n "${RUN_LOG:-}" ]] && print_run_log
  fi

  local scribe_dir="$ALLEYUUP_CODE_DIR/scribe"
  if (( ALLEYUUP_SCRIBE == 1 )) && [[ -f "$scribe_dir/package.json" ]] && has_working_cmd npm; then
    local need_scribe=0 scribe_msg=""
    if [[ ! -d "$scribe_dir/node_modules" ]] || [[ ! -f "$scribe_dir/dist/cli.js" ]]; then
      need_scribe=1
    elif [[ -n "$(find "$scribe_dir/src" "$scribe_dir/package.json" "$scribe_dir/tsconfig.json" -newer "$scribe_dir/dist/cli.js" 2>/dev/null | head -n 1)" ]]; then
      need_scribe=1
    fi

    if (( need_scribe == 1 )); then
      if is_dry_run; then
        scribe_msg="would rebuild"
      elif run_logged bash -c 'cd "$1" && npm install --loglevel=error --no-audit --no-fund && npm run --silent build' _ "$scribe_dir"; then
        clear_run_log
        scribe_msg="rebuilt"
      else
        scribe_msg="build failed"
        failed=1
      fi
    else
      scribe_msg="up to date"
    fi

    if ! command -v scribe >/dev/null 2>&1; then
      if is_dry_run; then
        scribe_msg="$scribe_msg; would run npm link"
      elif run_logged bash -c 'cd "$1" && npm link --loglevel=error' _ "$scribe_dir"; then
        clear_run_log
        scribe_msg="$scribe_msg; linked into PATH"
      else
        scribe_msg="$scribe_msg; npm link failed"
        failed=1
      fi
    fi

    printf "  %-8s %s\n" "scribe:" "$scribe_msg"
    [[ -n "${RUN_LOG:-}" ]] && print_run_log
  fi

  return $failed
}

