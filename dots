#!/usr/bin/env bash
set -euo pipefail

DOTS_VERSION="1.5.0"

BOLD="\033[1m"
BLUE="\033[1;34m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dots"
REPO_CONFIG_FILE="$CONFIG_DIR/repo"

# Tracked per-machine config mappings are owned by alleyuup (single source of truth)
# and loaded at runtime via `alleyuup --print-mappings`.
MAPPINGS=()

save_repo_dir() {
  local dir="$1"
  mkdir -p "$CONFIG_DIR"
  printf "%s\n" "$dir" > "$REPO_CONFIG_FILE"
}

resolve_tools_dir() {
  local source="${BASH_SOURCE[0]}"
  while [[ -L "$source" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  local candidate
  candidate="$(cd -P "$(dirname "$source")" && pwd)"
  if [[ -d "$candidate/.git" ]] && [[ "$candidate" != "$HOME/bin" ]] && [[ "$candidate" != "$HOME/.local/bin" ]]; then
    printf "%s\n" "$candidate"
    return 0
  fi
  return 1
}

# The tracked-file mapping list lives in alleyuup (single source of truth)
ALLEYUUP_BIN=""
SENSITIVE_PATTERNS=()

resolve_alleyuup_bin() {
  [[ -n "$ALLEYUUP_BIN" ]] && return 0
  local tools_dir=""
  if tools_dir="$(resolve_tools_dir 2>/dev/null)"; then
    if [[ -x "$tools_dir/alleyuup" ]]; then
      ALLEYUUP_BIN="$tools_dir/alleyuup"
    fi
  fi
  if [[ -z "$ALLEYUUP_BIN" ]] && command -v alleyuup >/dev/null 2>&1; then
    ALLEYUUP_BIN="$(command -v alleyuup)"
  fi
  [[ -n "$ALLEYUUP_BIN" ]]
}

load_sensitive_patterns() {
  (( ${#SENSITIVE_PATTERNS[@]} > 0 )) && return 0
  resolve_alleyuup_bin || return 1
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] && SENSITIVE_PATTERNS+=("$line")
  done < <("$ALLEYUUP_BIN" --print-sensitive-patterns 2>/dev/null)
  (( ${#SENSITIVE_PATTERNS[@]} > 0 ))
}

is_sensitive_path() {
  local path="$1" pattern
  load_sensitive_patterns || return 1
  for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    [[ "$path" == *"$pattern"* ]] && return 0
  done
  return 1
}

load_mappings() {
  MAPPINGS=()
  local line entry target

  if ! resolve_alleyuup_bin; then
    printf "${RED}dots requires 'alleyuup' in the same tools repo; re-run install.sh.${RESET}\n" >&2
    return 1
  fi

  while IFS= read -r line; do
    [[ -n "$line" ]] && MAPPINGS+=("$line")
  done < <("$ALLEYUUP_BIN" --print-mappings 2>/dev/null)

  if (( ${#MAPPINGS[@]} == 0 )); then
    printf "${RED}Could not read tracked file mappings from %s.${RESET}\n" "$ALLEYUUP_BIN" >&2
    return 1
  fi

  for entry in "${MAPPINGS[@]}"; do
    target="${entry#*:}"
    if is_sensitive_path "$target"; then
      printf "${RED}Refusing to manage sensitive path: %s${RESET}\n" "$target" >&2
      return 1
    fi
  done
  return 0
}

write_default_readme() {
  local file="$1"
  local host="${2:-mac}"
  cat <<EOF > "$file"
# Local Configs ($host)

This private Gist tracks per-machine configurations and the \`Brewfile\` for **$host**, managed by \`dots\` and \`alleyuup\`.

## Tracked Files
- \`alleyuup.conf\` -> \`~/.config/alleyuup/config\` (per-machine toggles, package exclusions, and hooks for \`alleyuup\`)
- \`config.fish\` -> \`~/.config/fish/config.fish\`
- \`openclaw.fish\` -> \`~/.config/fish/conf.d/openclaw.fish\`
- \`zprofile\` -> \`~/.zprofile\`
- \`gitconfig\` -> \`~/.gitconfig\`
- \`init.lua\` -> \`~/.hammerspoon/init.lua\`
- \`Brewfile\` -> Homebrew formulas, casks, Mac App Store apps, and global npm packages

## Quick Setup on a Machine
\`\`\`sh
mkdir -p ~/code ~/bin
# 1. Clone the shared alleyuup & dots tools Gist:
gh gist clone alleyuup-repo ~/code/alleyuup-repo
ln -sfn ~/code/alleyuup-repo/dots ~/bin/dots
ln -sfn ~/code/alleyuup-repo/alleyuup ~/bin/alleyuup

# 2. Point dots at this machine's config Gist (or run 'dots repo new') and link:
dots repo <machine-gist-id>
dots link
\`\`\`
EOF
}

configure_repo() {
  local input="${1:-}"

  if [[ -z "$input" ]]; then
    if [[ ! -t 0 ]]; then
      printf "${RED}No config repository configured for this machine. Run 'dots repo' interactively to set one.${RESET}\n" >&2
      exit 1
    fi

    printf "\n${BOLD}${BLUE}==> Configure Machine Config Repository${RESET}\n"
    printf "Specify how to track configs on this machine:\n"
    printf "  - Enter a ${BOLD}local directory path${RESET} (e.g. ~/code/my-dots)\n"
    printf "  - Enter a ${BOLD}Gist ID or Git URL${RESET} to clone into ~/code/\n"
    printf "  - Enter ${BOLD}new${RESET} to create & clone a new private GitHub Gist for this machine\n\n"
    read -r -p "Repo path, Gist ID/URL, or 'new': " input
  fi

  input="${input#"${input%%[![:space:]]*}"}"
  input="${input%"${input##*[![:space:]]}"}"

  if [[ -z "$input" ]]; then
    printf "${RED}Aborted: no repository specified.${RESET}\n" >&2
    exit 1
  fi

  local target_dir=""

  if [[ "$input" == "new" ]]; then
    if ! command -v gh >/dev/null 2>&1; then
      printf "${RED}'gh' CLI is required to create a new Gist automatically.${RESET}\n" >&2
      exit 1
    fi
    local host
    host="$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo "mac")"
    local tmp_dir
    tmp_dir="$(mktemp -d)"
    write_default_readme "$tmp_dir/README.md" "$host"
    printf "${BLUE}==> Creating new private Gist for %s...${RESET}\n" "$host"
    local gist_url
    gist_url="$(gh gist create "$tmp_dir/README.md" --desc "Local configs ($host)" | tail -n 1)"
    rm -rf "$tmp_dir"
    local gist_id="${gist_url##*/}"
    target_dir="$HOME/code/$gist_id"
    mkdir -p "$HOME/code"
    git clone "git@gist.github.com:${gist_id}.git" "$target_dir" || gh gist clone "$gist_id" "$target_dir"
  elif [[ "$input" =~ ^[0-9a-fA-F]{20,40}$ ]]; then
    target_dir="$HOME/code/$input"
    if [[ ! -d "$target_dir/.git" ]]; then
      mkdir -p "$HOME/code"
      printf "${BLUE}==> Cloning Gist %s into %s...${RESET}\n" "$input" "$target_dir"
      git clone "git@gist.github.com:${input}.git" "$target_dir" || gh gist clone "$input" "$target_dir"
    fi
  elif [[ "$input" =~ ^(git@|https?://|ssh://) ]]; then
    local base
    base="$(basename "$input" .git)"
    target_dir="$HOME/code/$base"
    if [[ ! -d "$target_dir/.git" ]]; then
      mkdir -p "$HOME/code"
      printf "${BLUE}==> Cloning %s into %s...${RESET}\n" "$input" "$target_dir"
      git clone "$input" "$target_dir"
    fi
  else
    target_dir="${input/#\~/$HOME}"
    if [[ ! -d "$target_dir" ]]; then
      mkdir -p "$target_dir"
    fi
    target_dir="$(cd -P "$target_dir" && pwd)"
    if [[ ! -d "$target_dir/.git" ]]; then
      printf "${BLUE}==> Initializing new Git repository in %s...${RESET}\n" "$target_dir"
      git -C "$target_dir" init -b main
    fi
  fi

  save_repo_dir "$target_dir"
  REPO_DIR="$target_dir"
  printf "${GREEN}✓ Saved machine config repo:${RESET} %s (stored in %s)\n" "$REPO_DIR" "$REPO_CONFIG_FILE"
}

ensure_repo_dir() {
  if [[ -n "${DOTFILES_GIST_DIR:-}" ]] && [[ -d "${DOTFILES_GIST_DIR}/.git" ]]; then
    REPO_DIR="$(cd -P "$DOTFILES_GIST_DIR" && pwd)"
    return 0
  fi

  if [[ -f "$REPO_CONFIG_FILE" ]]; then
    local saved
    saved="$(head -n 1 "$REPO_CONFIG_FILE" | tr -d '\r\n')"
    if [[ -n "$saved" ]] && [[ -d "$saved/.git" ]]; then
      REPO_DIR="$saved"
      return 0
    fi
  fi

  configure_repo ""
}

usage() {
  local current_repo="(not configured yet)"
  if [[ -f "$REPO_CONFIG_FILE" ]]; then
    current_repo="$(head -n 1 "$REPO_CONFIG_FILE" | tr -d '\r\n')"
  fi
  local tools_repo="(standalone)"
  if tools_repo="$(resolve_tools_dir 2>/dev/null)"; then
    :
  fi

  cat <<EOF
Usage: dots <command> [args]

Manage and sync local configs with this machine's config repo:
  Machine config repo: $current_repo
  Shared tools repo:   $tools_repo
  Config pointer file: $REPO_CONFIG_FILE

Commands:
  link              Symlink shared tools (alleyuup, dots) and machine configs into \$HOME
  status, st        Show symlink health and git status of both machine & tools repos
  diff              Show uncommitted changes in the machine config repo
  brewfile          Refresh Brewfile in the machine config repo via 'brew bundle dump'
  sync [msg]        Refresh Brewfile, pull --rebase, commit changes, and push
  pull              Pull latest changes from remote and re-verify symlinks
  add <path> [name] Move a local file into the machine config repo and symlink it
  clean [keep]      Remove stale '.bak.<timestamp>' backups (keeps newest 3 by default)
  doctor            Health check: links, completions, repo, PATH, schedule
  restore [--schedule]  Install Brewfile packages, link configs, optionally schedule
  lint              Syntax-check the scripts and run the test suite
  schedule [...]    Weekly launchd run: 'install [hour]', 'status', 'print', or 'remove'
  repo [target]     View or change the config repo for this machine (path, Gist ID/URL, or 'new')
  path              Print the path to this machine's config repo
  -h, --help        Show this help message
EOF
}

link_one() {
  local source_path="$1"
  local target="$2"

  if [[ ! -e "$source_path" ]]; then
    if [[ -f "$target" ]] && [[ ! -L "$target" ]]; then
      cp -a "$target" "$source_path"
      ln -sfn "$source_path" "$target"
      printf "${GREEN}✓ Tracked & linked${RESET} %s -> %s\n" "$target" "$source_path"
    fi
    return 0
  fi

  mkdir -p "$(dirname "$target")"

  if [[ -L "$target" ]]; then
    local current_link
    current_link="$(readlink "$target")"
    if [[ "$current_link" == "$source_path" ]]; then
      printf "${GREEN}✓${RESET} %s -> %s\n" "$target" "$source_path"
      return 0
    fi
  elif [[ -e "$target" ]]; then
    if cmp -s "$source_path" "$target"; then
      rm -f "$target"
    else
      local backup="${target}.bak.$(date +%Y%m%d%H%M%S)"
      mv "$target" "$backup"
      printf "${YELLOW}Backed up existing %s to %s${RESET}\n" "$target" "$backup"
    fi
  fi

  ln -sfn "$source_path" "$target"
  printf "${GREEN}✓ Linked${RESET} %s -> %s\n" "$target" "$source_path"
}

cmd_link() {
  local tools_dir=""
  if tools_dir="$(resolve_tools_dir)"; then
    printf "${BLUE}==> Linking shared scripts from %s${RESET}\n" "$tools_dir"
    link_one "$tools_dir/alleyuup" "$HOME/bin/alleyuup"
    link_one "$tools_dir/dots" "$HOME/bin/dots"

    local fish_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions"
    local zsh_dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"
    if [[ -f "$tools_dir/alleyuup.fish" ]] && { command -v fish >/dev/null 2>&1 || [[ -d "$(dirname "$fish_dir")" ]]; }; then
      mkdir -p "$fish_dir"
      link_one "$tools_dir/alleyuup.fish" "$fish_dir/alleyuup.fish"
      link_one "$tools_dir/dots.fish" "$fish_dir/dots.fish"
    fi
    if [[ -f "$tools_dir/_alleyuup" ]] && { command -v zsh >/dev/null 2>&1 || [[ -d "$(dirname "$zsh_dir")" ]]; }; then
      mkdir -p "$zsh_dir"
      link_one "$tools_dir/_alleyuup" "$zsh_dir/_alleyuup"
      link_one "$tools_dir/_dots" "$zsh_dir/_dots"
    fi
  fi

  load_mappings || exit 1
  ensure_repo_dir

  # Ensure alleyuup.conf exists in the machine repo so it can be linked and customized
  if [[ ! -f "$REPO_DIR/alleyuup.conf" ]] && [[ -x "$HOME/bin/alleyuup" ]]; then
    ALLEYUUP_CONFIG="$REPO_DIR/alleyuup.conf" "$HOME/bin/alleyuup" --init-config >/dev/null 2>&1 || true
  fi

  printf "\n${BLUE}==> Linking machine configs from %s${RESET}\n" "$REPO_DIR"
  for entry in "${MAPPINGS[@]}"; do
    local repo_name="${entry%%:*}"
    local target="${entry#*:}"
    link_one "$REPO_DIR/$repo_name" "$target"
  done
}

cmd_brewfile() {
  ensure_repo_dir
  if command -v brew >/dev/null 2>&1; then
    printf "${BLUE}==> Refreshing Brewfile${RESET}\n"
    if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
      brew bundle dump --file="$REPO_DIR/Brewfile" --force
    else
      HOMEBREW_BUNDLE_DUMP_NO_NPM=1 brew bundle dump --file="$REPO_DIR/Brewfile" --force
    fi
    printf "${GREEN}✓ Updated %s/Brewfile${RESET}\n" "$REPO_DIR"
  else
    printf "${YELLOW}⚠ Homebrew not found; skipping Brewfile dump${RESET}\n"
  fi
}

cmd_status() {
  local tools_dir=""
  if tools_dir="$(resolve_tools_dir)"; then
    printf "${BLUE}==> Shared Scripts (%s)${RESET}\n" "$tools_dir"
    for tool in alleyuup dots; do
      local target="$HOME/bin/$tool"
      local source_path="$tools_dir/$tool"
      if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$source_path" ]]; then
        printf "${GREEN}✓${RESET} %-42s -> %s\n" "$target" "$source_path"
      else
        printf "${YELLOW}⚠ Not linked:${RESET} %s (run 'dots link')\n" "$target"
      fi
    done
    git -C "$tools_dir" status -sb
    printf "\n"
  fi

  load_mappings || exit 1
  ensure_repo_dir
  printf "${BLUE}==> Machine Config Symlinks (%s)${RESET}\n" "$REPO_DIR"
  for entry in "${MAPPINGS[@]}"; do
    local repo_name="${entry%%:*}"
    local target="${entry#*:}"
    local source_path="$REPO_DIR/$repo_name"
    if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$source_path" ]]; then
      printf "${GREEN}✓${RESET} %-42s -> %s\n" "$target" "$repo_name"
    elif [[ -e "$target" ]]; then
      printf "${YELLOW}⚠ Not linked:${RESET} %s (run 'dots link')\n" "$target"
    elif [[ -e "$source_path" ]]; then
      printf "${RED}✗ Missing:${RESET} %s (run 'dots link')\n" "$target"
    fi
  done

  printf "\n${BLUE}==> Machine Repo Git Status (%s)${RESET}\n" "$REPO_DIR"
  git -C "$REPO_DIR" status -sb
}

cmd_sync() {
  local msg="${1:-Update configs ($(date '+%Y-%m-%d %H:%M'))}"
  local tools_dir=""
  if tools_dir="$(resolve_tools_dir)"; then
    git -C "$tools_dir" add -A
    if ! git -C "$tools_dir" diff --cached --quiet; then
      printf "${BLUE}==> Syncing shared scripts (%s)${RESET}\n" "$tools_dir"
      git -C "$tools_dir" commit -m "$msg"
      if git -C "$tools_dir" remote get-url origin >/dev/null 2>&1; then
        local tbranch
        tbranch="$(git -C "$tools_dir" symbolic-ref --short HEAD 2>/dev/null | head -n 1 | tr -d '[:space:]')"
        [[ -z "$tbranch" ]] && tbranch="main"
        git -C "$tools_dir" pull --rebase origin "$tbranch"
        git -C "$tools_dir" push origin "$tbranch"
        printf "${GREEN}✓ Shared scripts synced!${RESET}\n\n"
      fi
    fi
  fi

  ensure_repo_dir
  cmd_brewfile
  git -C "$REPO_DIR" add -A
  if ! git -C "$REPO_DIR" diff --cached --quiet; then
    printf "\n${BLUE}==> Syncing machine configs (%s)${RESET}\n" "$REPO_DIR"
    git -C "$REPO_DIR" commit -m "$msg"
    if git -C "$REPO_DIR" remote get-url origin >/dev/null 2>&1; then
      local branch
      branch="$(git -C "$REPO_DIR" symbolic-ref --short HEAD 2>/dev/null | head -n 1 | tr -d '[:space:]')"
      [[ -z "$branch" ]] && branch="main"
      if git -C "$REPO_DIR" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
        git -C "$REPO_DIR" pull --rebase origin "$branch"
      fi
      if ! git -C "$REPO_DIR" push origin "$branch"; then
        printf "${YELLOW}⚠ Failed to push machine configs to %s (%s)${RESET}\n" "$REPO_DIR" "$branch" >&2
        return 1
      fi
      printf "${BOLD}${GREEN}✨ Machine configs synced!${RESET}\n"
    else
      printf "${YELLOW}⚠ No 'origin' git remote configured in %s; changes committed locally.${RESET}\n" "$REPO_DIR"
    fi
  elif [[ -n "$(git -C "$REPO_DIR" status --porcelain -b 2>/dev/null | grep '^## .*\[ahead ')" ]]; then
    local branch
    branch="$(git -C "$REPO_DIR" symbolic-ref --short HEAD 2>/dev/null | head -n 1 | tr -d '[:space:]')"
    [[ -z "$branch" ]] && branch="main"
    git -C "$REPO_DIR" pull --rebase origin "$branch"
    git -C "$REPO_DIR" push origin "$branch"
    printf "${BOLD}${GREEN}✨ Machine configs synced!${RESET}\n"
  else
    printf "${GREEN}✓ Machine configs (%s) already up to date.${RESET}\n" "$REPO_DIR"
  fi
}

cmd_pull() {
  local tools_dir=""
  if tools_dir="$(resolve_tools_dir)"; then
    printf "${BLUE}==> Pulling shared scripts (%s)${RESET}\n" "$tools_dir"
    local tbranch
    tbranch="$(git -C "$tools_dir" symbolic-ref --short HEAD 2>/dev/null || echo "main")"
    git -C "$tools_dir" pull --rebase origin "$tbranch"
  fi

  ensure_repo_dir
  printf "\n${BLUE}==> Pulling machine configs (%s)${RESET}\n" "$REPO_DIR"
  local branch
  branch="$(git -C "$REPO_DIR" symbolic-ref --short HEAD 2>/dev/null || echo "main")"
  git -C "$REPO_DIR" pull --rebase origin "$branch"
  cmd_link
}

cmd_clean() {
  load_mappings || exit 1
  local keep="${1:-3}"
  if ! [[ "$keep" =~ ^[0-9]+$ ]]; then
    printf "${RED}Usage: dots clean [keep-count]${RESET}\n" >&2
    exit 1
  fi

  printf "${BLUE}==> Removing stale link backups (keeping newest %s per file)${RESET}\n" "$keep"
  local entry target dir base f idx removed=0
  for entry in "${MAPPINGS[@]}"; do
    target="${entry#*:}"
    dir="$(dirname "$target")"
    base="$(basename "$target")"
    [[ -d "$dir" ]] || continue

    idx=0
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      idx=$((idx + 1))
      if (( idx > keep )); then
        rm -f "$f"
        printf "  removed %s\n" "$f"
        removed=$((removed + 1))
      fi
    done < <(find "$dir" -maxdepth 1 -type f -name "${base}.bak.*" -print 2>/dev/null | sort -r)
  done

  if (( removed == 0 )); then
    printf "${GREEN}✓ No stale backups to remove.${RESET}\n"
  else
    printf "${GREEN}✓ Removed %d stale backup(s).${RESET}\n" "$removed"
  fi
}

cmd_lint() {
  local tools_dir="" failed=0 f
  if ! tools_dir="$(resolve_tools_dir)"; then
    printf "${RED}dots lint must run from the shared tools repo.${RESET}\n" >&2
    exit 1
  fi

  printf "${BLUE}==> bash -n (syntax)${RESET}\n"
  for f in "$tools_dir/alleyuup" "$tools_dir/dots" "$tools_dir/install.sh" "$tools_dir/test-alleyuup.sh"; do
    [[ -f "$f" ]] || continue
    if bash -n "$f"; then
      printf "  ✓ %s\n" "$(basename "$f")"
    else
      failed=1
    fi
  done

  printf "\n${BLUE}==> tracked mappings${RESET}\n"
  if load_mappings; then
    printf "  ✓ %d mappings, no sensitive paths\n" "${#MAPPINGS[@]}"
  else
    failed=1
  fi

  if command -v shellcheck >/dev/null 2>&1; then
    printf "\n${BLUE}==> shellcheck (warning+)${RESET}\n"
    for f in "$tools_dir/alleyuup" "$tools_dir/dots" "$tools_dir/install.sh"; do
      [[ -f "$f" ]] || continue
      if shellcheck -S warning "$f"; then
        printf "  ✓ %s\n" "$(basename "$f")"
      else
        failed=1
      fi
    done
  else
    printf "\n${YELLOW}shellcheck not installed; skipping (brew install shellcheck).${RESET}\n"
  fi

  if [[ -d "$tools_dir" ]]; then
    local test_script
    for test_script in "$tools_dir"/test-*.sh; do
      [[ -f "$test_script" ]] || continue
      printf "\n${BLUE}==> %s${RESET}\n" "$(basename "$test_script")"
      if ! "$test_script"; then
        failed=1
      fi
    done
  fi

  if (( failed == 0 )); then
    printf "\n${GREEN}✓ Lint passed.${RESET}\n"
  else
    printf "\n${RED}✗ Lint failed.${RESET}\n"
  fi
  return $failed
}

schedule_plist_content() {
  local hour="$1"
  local label="com.ryanmcquen.alleyuup"
  local log="$HOME/Library/Logs/alleyuup.log"

  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$HOME/bin/alleyuup</string>
    <string>--fast</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$HOME/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ALLEYUUP_LOG</key>
    <string>$log</string>
    <key>ALLEYUUP_NOTIFY</key>
    <string>1</string>
    <key>ALLEYUUP_MAX_RUNTIME</key>
    <string>3600</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>$hour</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
</dict>
</plist>
PLIST
}

cmd_schedule() {
  local action="${1:-status}"
  local hour="${2:-3}"
  local label="com.ryanmcquen.alleyuup"
  local plist_dir="$HOME/Library/LaunchAgents"
  local plist="$plist_dir/$label.plist"
  local log="$HOME/Library/Logs/alleyuup.log"

  if ! [[ "$hour" =~ ^[0-9]+$ ]] || (( hour < 0 || hour > 23 )); then
    printf "${RED}Hour must be 0-23.${RESET}\n" >&2
    exit 1
  fi

  case "$action" in
    status)
      if [[ -f "$plist" ]]; then
        printf "Plist:  %s\n" "$plist"
        printf "Log:    %s\n" "$log"
        if launchctl list "$label" >/dev/null 2>&1; then
          printf "Loaded: ${GREEN}yes${RESET}\n"
        else
          printf "Loaded: ${YELLOW}no${RESET}\n"
        fi
      else
        printf "Not scheduled. Run 'dots schedule install [hour]'.\n"
      fi
      ;;
    print)
      schedule_plist_content "$hour"
      ;;
    install)
      mkdir -p "$plist_dir" "$(dirname "$log")"
      schedule_plist_content "$hour" > "$plist"
      launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
      if launchctl bootstrap "gui/$(id -u)" "$plist" >/dev/null 2>&1; then
        :
      else
        launchctl load -w "$plist" >/dev/null 2>&1 || true
      fi
      printf "${GREEN}✓ Scheduled weekly (Sunday %02d:00) -> %s${RESET}\n" "$hour" "$plist"
      printf "  Log: %s (rotated automatically)\n" "$log"
      ;;
    remove|uninstall)
      launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || launchctl unload -w "$plist" >/dev/null 2>&1 || true
      rm -f "$plist"
      printf "${GREEN}✓ Removed schedule.${RESET}\n"
      ;;
    *)
      printf "${RED}Usage: dots schedule [install|status|remove] [hour]${RESET}\n" >&2
      exit 1
      ;;
  esac
}

HEALTH_WARNINGS=0
HEALTH_PROBLEMS=0

health_ok() {
  printf "  ${GREEN}✓${RESET} %s\n" "$1"
}

health_warn() {
  HEALTH_WARNINGS=$((HEALTH_WARNINGS + 1))
  printf "  ${YELLOW}⚠${RESET} %s\n" "$1"
}

health_bad() {
  HEALTH_PROBLEMS=$((HEALTH_PROBLEMS + 1))
  printf "  ${RED}✗${RESET} %s\n" "$1"
}

cmd_doctor() {
  HEALTH_WARNINGS=0
  HEALTH_PROBLEMS=0
  local tools_dir="" entry repo_name target source_path linked=0 unlinked=0 absent=0
  local repo_dir=""

  printf "${BLUE}==> Shared scripts${RESET}\n"
  if tools_dir="$(resolve_tools_dir 2>/dev/null)"; then
    health_ok "tools repo: $tools_dir"
    local tool
    for tool in alleyuup dots; do
      target="$HOME/bin/$tool"
      source_path="$tools_dir/$tool"
      if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$source_path" ]]; then
        health_ok "~/bin/$tool linked"
      else
        health_bad "~/bin/$tool is not linked (run 'dots link')"
      fi
    done
    if [[ -n "$(git -C "$tools_dir" status --porcelain 2>/dev/null)" ]]; then
      health_warn "tools repo has uncommitted changes"
    fi
  else
    health_warn "dots is not running from a git clone; run install.sh"
  fi

  printf "\n${BLUE}==> Completions${RESET}\n"
  local fish_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions"
  if [[ -f "$fish_dir/alleyuup.fish" ]] && [[ -f "$fish_dir/dots.fish" ]]; then
    health_ok "fish: $fish_dir"
  else
    health_warn "fish completions not linked (run 'dots link')"
  fi
  local zsh_dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"
  if [[ -f "$zsh_dir/_alleyuup" ]] && [[ -f "$zsh_dir/_dots" ]]; then
    health_ok "zsh: $zsh_dir"
  else
    health_warn "zsh completions not linked (run 'dots link')"
  fi

  printf "\n${BLUE}==> Machine repo${RESET}\n"
  if [[ -n "${DOTFILES_GIST_DIR:-}" ]] && [[ -d "${DOTFILES_GIST_DIR}" ]]; then
    repo_dir="$(cd -P "$DOTFILES_GIST_DIR" && pwd)"
    health_ok "configured via DOTFILES_GIST_DIR: $repo_dir"
  elif [[ -f "$REPO_CONFIG_FILE" ]]; then
    repo_dir="$(head -n 1 "$REPO_CONFIG_FILE" | tr -d '\r\n')"
    if [[ -n "$repo_dir" ]] && [[ -d "$repo_dir" ]]; then
      health_ok "configured: $repo_dir"
    else
      health_bad "configured repo missing: ${repo_dir:-<empty>}"
      repo_dir=""
    fi
  else
    health_warn "no machine repo configured (run 'dots repo')"
  fi

  if [[ -n "$repo_dir" ]]; then
    if [[ -d "$repo_dir/.git" ]]; then
      health_ok "is a git repo"
      if [[ -z "$(git -C "$repo_dir" status --porcelain 2>/dev/null)" ]]; then
        health_ok "working tree clean"
      else
        health_warn "working tree has changes (run 'dots sync')"
      fi
      if git -C "$repo_dir" remote get-url origin >/dev/null 2>&1; then
        health_ok "origin remote configured"
      else
        health_warn "no origin remote; changes will stay local"
      fi
    else
      health_bad "$repo_dir is not a git repo"
    fi
  fi

  printf "\n${BLUE}==> Tracked configs${RESET}\n"
  if load_mappings; then
    local sensitive=0
    for entry in "${MAPPINGS[@]}"; do
      repo_name="${entry%%:*}"
      target="${entry#*:}"
      if is_sensitive_path "$target"; then
        health_bad "sensitive path in mappings: $target"
        sensitive=1
      fi
      if [[ -n "$repo_dir" ]]; then
        source_path="$repo_dir/$repo_name"
        if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$source_path" ]]; then
          linked=$((linked + 1))
        elif [[ -e "$source_path" ]]; then
          unlinked=$((unlinked + 1))
        else
          absent=$((absent + 1))
        fi
      fi
    done
    health_ok "read ${#MAPPINGS[@]} mappings from alleyuup"
    if (( sensitive == 0 )); then
      health_ok "no sensitive paths tracked"
    fi
    if [[ -n "$repo_dir" ]]; then
      if (( unlinked > 0 )); then
        health_warn "$unlinked tracked file(s) not linked (run 'dots link')"
      else
        health_ok "$linked tracked file(s) linked"
      fi
      if (( absent > 0 )); then
        health_warn "$absent mapped file(s) absent on this machine (fine if unused)"
      fi
    fi
  else
    health_bad "could not load tracked file mappings"
  fi

  printf "\n${BLUE}==> Environment${RESET}\n"
  if [[ ":$PATH:" == *":$HOME/bin:"* ]]; then
    health_ok "~/bin is on PATH"
  else
    health_warn "~/bin is not on PATH"
  fi
  if command -v alleyuup >/dev/null 2>&1; then
    health_ok "alleyuup: $(alleyuup --version 2>/dev/null | head -n 1)"
  else
    health_bad "alleyuup not found on PATH"
  fi

  printf "\n${BLUE}==> Run state${RESET}\n"
  local lock_dir="${ALLEYUUP_LOCK_DIR:-${TMPDIR:-/tmp}/alleyuup.lock}"
  if [[ -d "$lock_dir" ]]; then
    local lock_pid="" lock_started=""
    if [[ -f "$lock_dir/pid" ]]; then
      lock_pid="$(head -n 1 "$lock_dir/pid" 2>/dev/null | tr -d '\r\n')"
    fi
    if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
      if [[ -f "$lock_dir/started" ]]; then
        lock_started="$(head -n 1 "$lock_dir/started" 2>/dev/null | tr -d '\r\n')"
      fi
      if [[ "$lock_started" =~ ^[0-9]+$ ]]; then
        health_warn "alleyuup is running (pid $lock_pid, $(( ($(date +%s) - lock_started) / 60 ))m)"
      else
        health_warn "alleyuup is running (pid $lock_pid)"
      fi
    else
      health_warn "stale run lock at $lock_dir (next run will reclaim it)"
    fi
  else
    health_ok "no run in progress"
  fi

  printf "\n${BLUE}==> Schedule${RESET}\n"
  local label="com.ryanmcquen.alleyuup"
  local plist="$HOME/Library/LaunchAgents/$label.plist"
  local log="$HOME/Library/Logs/alleyuup.log"
  if [[ -f "$plist" ]]; then
    if launchctl list "$label" >/dev/null 2>&1; then
      health_ok "weekly job loaded"
      local sched_out runs last_exit
      sched_out="$(launchctl print "gui/$(id -u)/$label" 2>/dev/null || true)"
      runs="$(printf '%s\n' "$sched_out" | awk -F'= ' '/runs =/{print $2; exit}')"
      last_exit="$(printf '%s\n' "$sched_out" | awk -F'= ' '/last exit code =/{print $2; exit}')"
      if [[ -n "$runs" ]]; then
        health_ok "runs: $runs, last exit: ${last_exit:-never}"
      fi
      if [[ -n "$last_exit" ]] && [[ "$last_exit" != "0" ]] && [[ "$last_exit" != "(never exited)" ]]; then
        health_warn "last scheduled run exited $last_exit"
      fi
    else
      health_warn "plist exists but job is not loaded"
    fi
  else
    health_warn "no weekly job (run 'dots schedule install')"
  fi

  if [[ -f "$log" ]]; then
    health_ok "log: $(wc -c < "$log" | tr -d ' ') bytes, last write $(date -r "$log" '+%Y-%m-%d %H:%M')"
  else
    health_warn "no log file yet"
  fi

  printf "\n"
  if (( HEALTH_PROBLEMS > 0 )); then
    printf "${RED}✗ %d problem(s), %d warning(s).${RESET}\n" "$HEALTH_PROBLEMS" "$HEALTH_WARNINGS"
    return 1
  elif (( HEALTH_WARNINGS > 0 )); then
    printf "${YELLOW}⚠ %d warning(s), no problems.${RESET}\n" "$HEALTH_WARNINGS"
    return 0
  else
    printf "${GREEN}✓ All checks passed.${RESET}\n"
    return 0
  fi
}

cmd_restore() {
  local with_schedule=0 arg
  for arg in "$@"; do
    case "$arg" in
      --schedule) with_schedule=1 ;;
    esac
  done

  ensure_repo_dir
  printf "${BLUE}==> Restoring from %s${RESET}\n" "$REPO_DIR"

  if command -v brew >/dev/null 2>&1 && [[ -f "$REPO_DIR/Brewfile" ]]; then
    printf "${BLUE}==> Installing packages from Brewfile${RESET}\n"
    if ! brew bundle --file="$REPO_DIR/Brewfile" --no-lock; then
      printf "${YELLOW}⚠ brew bundle exited with errors; continuing.${RESET}\n"
    fi
  else
    printf "${YELLOW}⚠ Homebrew or Brewfile missing; skipping package restore.${RESET}\n"
  fi

  cmd_link

  if (( with_schedule == 1 )); then
    cmd_schedule install
  fi

  printf "\n${BOLD}${GREEN}✨ Restore complete.${RESET}\n"
}

cmd_add() {
  ensure_repo_dir
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    printf "${RED}Usage: dots add <path-to-file> [repo-filename]${RESET}\n" >&2
    exit 1
  fi

  target="${target/#\~/$HOME}"
  if [[ ! -e "$target" ]]; then
    printf "${RED}File not found: %s${RESET}\n" "$target" >&2
    exit 1
  fi

  local abs_target
  abs_target="$(cd -P "$(dirname "$target")" && pwd)/$(basename "$target")"

  if is_sensitive_path "$abs_target"; then
    printf "${RED}Refusing to track sensitive path: %s${RESET}\n" "$abs_target" >&2
    exit 1
  fi

  local repo_name="${2:-$(basename "$abs_target")}"
  repo_name="${repo_name#.}"
  local dest="$REPO_DIR/$repo_name"

  if [[ -L "$abs_target" ]] && [[ "$(readlink "$abs_target")" == "$dest" ]]; then
    printf "${GREEN}✓ %s is already tracked as %s${RESET}\n" "$abs_target" "$repo_name"
    return 0
  fi

  cp -a "$abs_target" "$dest"
  ln -sfn "$dest" "$abs_target"
  printf "${GREEN}✓ Added and linked:${RESET} %s -> %s\n" "$abs_target" "$dest"

  local tools_dir=""
  local dots_script=""
  if tools_dir="$(resolve_tools_dir)"; then
    dots_script="$tools_dir/dots"
  fi
  local mapping_entry="${repo_name}:${abs_target/#$HOME/\$HOME}"
  if [[ -n "$dots_script" ]] && [[ -f "$dots_script" ]] && ! grep -Fq "\"$mapping_entry\"" "$dots_script"; then
    local tmp_dots="${dots_script}.tmp.$$"
    awk -v entry="  \"$mapping_entry\"" '
      /^MAPPINGS=\(/ { in_map = 1 }
      in_map && /^\)/ { print entry; in_map = 0 }
      { print }
    ' "$dots_script" > "$tmp_dots" && chmod +x "$tmp_dots" && mv "$tmp_dots" "$dots_script"
    printf "${GREEN}✓ Registered %s in dots MAPPINGS${RESET}\n" "$mapping_entry"
  fi
}

COMMAND="${1:-status}"
shift || true

case "$COMMAND" in
  link|install)
    cmd_link
    ;;
  status|st)
    cmd_status
    ;;
  diff)
    ensure_repo_dir
    git -C "$REPO_DIR" diff
    ;;
  brewfile|brew)
    cmd_brewfile
    ;;
  sync|push)
    cmd_sync "${1:-}"
    ;;
  pull)
    cmd_pull
    ;;
  add|track)
    cmd_add "${1:-}" "${2:-}"
    ;;
  clean)
    cmd_clean "${1:-3}"
    ;;
  lint|test)
    cmd_lint
    ;;
  doctor|health)
    cmd_doctor
    ;;
  restore)
    cmd_restore "${1:-}"
    ;;
  schedule|sched)
    cmd_schedule "${1:-status}" "${2:-3}"
    ;;
  repo|init)
    configure_repo "${1:-}"
    ;;
  path)
    ensure_repo_dir
    printf "%s\n" "$REPO_DIR"
    ;;
  -v|--version|version)
    if tools_dir="$(resolve_tools_dir 2>/dev/null)"; then
      printf "dots v%s (r%s, %s)\n" "$DOTS_VERSION" "$(git -C "$tools_dir" rev-list --count HEAD 2>/dev/null || echo 0)" "$(git -C "$tools_dir" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    else
      printf "dots v%s (standalone)\n" "$DOTS_VERSION"
    fi
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    printf "${RED}Unknown command: %s${RESET}\n\n" "$COMMAND" >&2
    usage >&2
    exit 1
    ;;
esac
