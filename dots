#!/usr/bin/env bash
set -euo pipefail

DOTS_VERSION="1.0.5"

BOLD="\033[1m"
BLUE="\033[1;34m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dots"
REPO_CONFIG_FILE="$CONFIG_DIR/repo"

# Tracked per-machine config mappings: <gist_filename>:<target_path_in_home>
MAPPINGS=(
  "alleyup.conf:$HOME/.config/alleyup/config"
  "config.fish:$HOME/.config/fish/config.fish"
  "openclaw.fish:$HOME/.config/fish/conf.d/openclaw.fish"
  "config.nu:$HOME/.config/nushell/config.nu"
  "env.nu:$HOME/.config/nushell/env.nu"
  "login.nu:$HOME/.config/nushell/login.nu"
  "mac_config.nu:$HOME/Library/Application Support/nushell/config.nu"
  "mac_env.nu:$HOME/Library/Application Support/nushell/env.nu"
  "mac_login.nu:$HOME/Library/Application Support/nushell/login.nu"
  "starship.toml:$HOME/.config/starship.toml"
  "zshrc:$HOME/.zshrc"
  "zprofile:$HOME/.zprofile"
  "zshenv:$HOME/.zshenv"
  "zlogin:$HOME/.zlogin"
  "bashrc:$HOME/.bashrc"
  "bash_profile:$HOME/.bash_profile"
  "bash_aliases:$HOME/.bash_aliases"
  "profile:$HOME/.profile"
  "inputrc:$HOME/.inputrc"
  "vimrc:$HOME/.vimrc"
  "emacs:$HOME/.emacs"
  "emacs_init.el:$HOME/.emacs.d/init.el"
  "emacs_early_init.el:$HOME/.emacs.d/early-init.el"
  "xdg_emacs_init.el:$HOME/.config/emacs/init.el"
  "xdg_emacs_early_init.el:$HOME/.config/emacs/early-init.el"
  "doom_init.el:$HOME/.config/doom/init.el"
  "doom_config.el:$HOME/.config/doom/config.el"
  "doom_packages.el:$HOME/.config/doom/packages.el"
  "spacemacs:$HOME/.spacemacs"
  "tmux.conf:$HOME/.tmux.conf"
  "gitconfig:$HOME/.gitconfig"
  "gh_config.yml:$HOME/.config/gh/config.yml"
  "flint.conf:$HOME/.config/flint/config"
  "opencode_cli.json:$HOME/.config/opencode/cli.json"
  "Preferences.sublime-settings:$HOME/Library/Application Support/Sublime Text/Packages/User/Preferences.sublime-settings"
  "Default (OSX).sublime-keymap:$HOME/Library/Application Support/Sublime Text/Packages/User/Default (OSX).sublime-keymap"
  "Package Control.sublime-settings:$HOME/Library/Application Support/Sublime Text/Packages/User/Package Control.sublime-settings"
  "init.lua:$HOME/.hammerspoon/init.lua"
)

save_repo_dir() {
  local dir="$1"
  mkdir -p "$CONFIG_DIR"
  printf "%s\n" "$dir" > "$REPO_CONFIG_FILE"
}

resolve_tools_dir() {
  local source="${BASH_SOURCE[0]}"
  while [[ -L "$source" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  local candidate
  candidate="$(cd -P "$(dirname "$source")" && pwd)"
  if [[ -d "$candidate/.git" ]] && [[ "$candidate" != "$HOME/bin" ]] && [[ "$candidate" != "$HOME/.local/bin" ]]; then
    printf "%s\n" "$candidate"
    return 0
  fi
  return 1
}

write_default_readme() {
  local file="$1"
  local host="${2:-mac}"
  cat <<EOF > "$file"
# Local Configs ($host)

This private Gist tracks per-machine configurations and the \`Brewfile\` for **$host**, managed by \`dots\` and \`alleyup\`.

## Tracked Files
- \`alleyup.conf\` -> \`~/.config/alleyup/config\` (per-machine toggles, package exclusions, and hooks for \`alleyup\`)
- \`config.fish\` -> \`~/.config/fish/config.fish\`
- \`openclaw.fish\` -> \`~/.config/fish/conf.d/openclaw.fish\`
- \`zprofile\` -> \`~/.zprofile\`
- \`gitconfig\` -> \`~/.gitconfig\`
- \`init.lua\` -> \`~/.hammerspoon/init.lua\`
- \`Brewfile\` -> Homebrew formulas, casks, Mac App Store apps, and global npm packages

## Quick Setup on a Machine
\`\`\`sh
mkdir -p ~/code ~/bin
# 1. Clone the shared alleyup & dots tools Gist:
gh gist clone alleyuup-repo ~/code/alleyuup-repo
ln -sfn ~/code/alleyuup-repo/dots ~/bin/dots
ln -sfn ~/code/alleyuup-repo/alleyup ~/bin/alleyup

# 2. Point dots at this machine's config Gist (or run 'dots repo new') and link:
dots repo <machine-gist-id>
dots link
\`\`\`
EOF
}

configure_repo() {
  local input="${1:-}"

  if [[ -z "$input" ]]; then
    if [[ ! -t 0 ]]; then
      printf "${RED}No config repository configured for this machine. Run 'dots repo' interactively to set one.${RESET}\n" >&2
      exit 1
    fi

    printf "\n${BOLD}${BLUE}==> Configure Machine Config Repository${RESET}\n"
    printf "Specify how to track configs on this machine:\n"
    printf "  - Enter a ${BOLD}local directory path${RESET} (e.g. ~/code/my-dots)\n"
    printf "  - Enter a ${BOLD}Gist ID or Git URL${RESET} to clone into ~/code/\n"
    printf "  - Enter ${BOLD}new${RESET} to create & clone a new private GitHub Gist for this machine\n\n"
    read -r -p "Repo path, Gist ID/URL, or 'new': " input
  fi

  input="${input#"${input%%[![:space:]]*}"}"
  input="${input%"${input##*[![:space:]]}"}"

  if [[ -z "$input" ]]; then
    printf "${RED}Aborted: no repository specified.${RESET}\n" >&2
    exit 1
  fi

  local target_dir=""

  if [[ "$input" == "new" ]]; then
    if ! command -v gh >/dev/null 2>&1; then
      printf "${RED}'gh' CLI is required to create a new Gist automatically.${RESET}\n" >&2
      exit 1
    fi
    local host
    host="$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo "mac")"
    local tmp_dir
    tmp_dir="$(mktemp -d)"
    write_default_readme "$tmp_dir/README.md" "$host"
    printf "${BLUE}==> Creating new private Gist for %s...${RESET}\n" "$host"
    local gist_url
    gist_url="$(gh gist create "$tmp_dir/README.md" --desc "Local configs ($host)" | tail -n 1)"
    rm -rf "$tmp_dir"
    local gist_id="${gist_url##*/}"
    target_dir="$HOME/code/$gist_id"
    mkdir -p "$HOME/code"
    git clone "git@gist.github.com:${gist_id}.git" "$target_dir" || gh gist clone "$gist_id" "$target_dir"
  elif [[ "$input" =~ ^[0-9a-fA-F]{20,40}$ ]]; then
    target_dir="$HOME/code/$input"
    if [[ ! -d "$target_dir/.git" ]]; then
      mkdir -p "$HOME/code"
      printf "${BLUE}==> Cloning Gist %s into %s...${RESET}\n" "$input" "$target_dir"
      git clone "git@gist.github.com:${input}.git" "$target_dir" || gh gist clone "$input" "$target_dir"
    fi
  elif [[ "$input" =~ ^(git@|https?://|ssh://) ]]; then
    local base
    base="$(basename "$input" .git)"
    target_dir="$HOME/code/$base"
    if [[ ! -d "$target_dir/.git" ]]; then
      mkdir -p "$HOME/code"
      printf "${BLUE}==> Cloning %s into %s...${RESET}\n" "$input" "$target_dir"
      git clone "$input" "$target_dir"
    fi
  else
    target_dir="${input/#\~/$HOME}"
    if [[ ! -d "$target_dir" ]]; then
      mkdir -p "$target_dir"
    fi
    target_dir="$(cd -P "$target_dir" && pwd)"
    if [[ ! -d "$target_dir/.git" ]]; then
      printf "${BLUE}==> Initializing new Git repository in %s...${RESET}\n" "$target_dir"
      git -C "$target_dir" init -b main
    fi
  fi

  save_repo_dir "$target_dir"
  REPO_DIR="$target_dir"
  printf "${GREEN}✓ Saved machine config repo:${RESET} %s (stored in %s)\n" "$REPO_DIR" "$REPO_CONFIG_FILE"
}

ensure_repo_dir() {
  if [[ -n "${DOTFILES_GIST_DIR:-}" ]] && [[ -d "${DOTFILES_GIST_DIR}/.git" ]]; then
    REPO_DIR="$(cd -P "$DOTFILES_GIST_DIR" && pwd)"
    return 0
  fi

  if [[ -f "$REPO_CONFIG_FILE" ]]; then
    local saved
    saved="$(head -n 1 "$REPO_CONFIG_FILE" | tr -d '\r\n')"
    if [[ -n "$saved" ]] && [[ -d "$saved/.git" ]]; then
      REPO_DIR="$saved"
      return 0
    fi
  fi

  configure_repo ""
}

usage() {
  local current_repo="(not configured yet)"
  if [[ -f "$REPO_CONFIG_FILE" ]]; then
    current_repo="$(head -n 1 "$REPO_CONFIG_FILE" | tr -d '\r\n')"
  fi
  local tools_repo="(standalone)"
  if tools_repo="$(resolve_tools_dir 2>/dev/null)"; then
    :
  fi

  cat <<EOF
Usage: dots <command> [args]

Manage and sync local configs with this machine's config repo:
  Machine config repo: $current_repo
  Shared tools repo:   $tools_repo
  Config pointer file: $REPO_CONFIG_FILE

Commands:
  link              Symlink shared tools (alleyup, dots) and machine configs into \$HOME
  status, st        Show symlink health and git status of both machine & tools repos
  diff              Show uncommitted changes in the machine config repo
  brewfile          Refresh Brewfile in the machine config repo via 'brew bundle dump'
  sync [msg]        Refresh Brewfile, pull --rebase, commit changes, and push
  pull              Pull latest changes from remote and re-verify symlinks
  add <path> [name] Move a local file into the machine config repo and symlink it
  repo [target]     View or change the config repo for this machine (path, Gist ID/URL, or 'new')
  path              Print the path to this machine's config repo
  -h, --help        Show this help message
EOF
}

link_one() {
  local source_path="$1"
  local target="$2"

  if [[ ! -e "$source_path" ]]; then
    if [[ -f "$target" ]] && [[ ! -L "$target" ]]; then
      cp -a "$target" "$source_path"
      ln -sfn "$source_path" "$target"
      printf "${GREEN}✓ Tracked & linked${RESET} %s -> %s\n" "$target" "$source_path"
    fi
    return 0
  fi

  mkdir -p "$(dirname "$target")"

  if [[ -L "$target" ]]; then
    local current_link
    current_link="$(readlink "$target")"
    if [[ "$current_link" == "$source_path" ]]; then
      printf "${GREEN}✓${RESET} %s -> %s\n" "$target" "$source_path"
      return 0
    fi
  elif [[ -e "$target" ]]; then
    if cmp -s "$source_path" "$target"; then
      rm -f "$target"
    else
      local backup="${target}.bak.$(date +%Y%m%d%H%M%S)"
      mv "$target" "$backup"
      printf "${YELLOW}Backed up existing %s to %s${RESET}\n" "$target" "$backup"
    fi
  fi

  ln -sfn "$source_path" "$target"
  printf "${GREEN}✓ Linked${RESET} %s -> %s\n" "$target" "$source_path"
}

cmd_link() {
  local tools_dir=""
  if tools_dir="$(resolve_tools_dir)"; then
    printf "${BLUE}==> Linking shared scripts from %s${RESET}\n" "$tools_dir"
    link_one "$tools_dir/alleyup" "$HOME/bin/alleyup"
    link_one "$tools_dir/dots" "$HOME/bin/dots"
  fi

  ensure_repo_dir

  # Ensure alleyup.conf exists in the machine repo so it can be linked and customized
  if [[ ! -f "$REPO_DIR/alleyup.conf" ]] && [[ -x "$HOME/bin/alleyup" ]]; then
    ALLEYUP_CONFIG="$REPO_DIR/alleyup.conf" "$HOME/bin/alleyup" --config >/dev/null 2>&1 || true
  fi

  printf "\n${BLUE}==> Linking machine configs from %s${RESET}\n" "$REPO_DIR"
  for entry in "${MAPPINGS[@]}"; do
    local repo_name="${entry%%:*}"
    local target="${entry#*:}"
    link_one "$REPO_DIR/$repo_name" "$target"
  done
}

cmd_brewfile() {
  ensure_repo_dir
  if command -v brew >/dev/null 2>&1; then
    printf "${BLUE}==> Refreshing Brewfile${RESET}\n"
    if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
      brew bundle dump --file="$REPO_DIR/Brewfile" --force
    else
      HOMEBREW_BUNDLE_DUMP_NO_NPM=1 brew bundle dump --file="$REPO_DIR/Brewfile" --force
    fi
    printf "${GREEN}✓ Updated %s/Brewfile${RESET}\n" "$REPO_DIR"
  else
    printf "${YELLOW}⚠ Homebrew not found; skipping Brewfile dump${RESET}\n"
  fi
}

cmd_status() {
  local tools_dir=""
  if tools_dir="$(resolve_tools_dir)"; then
    printf "${BLUE}==> Shared Scripts (%s)${RESET}\n" "$tools_dir"
    for tool in alleyup dots; do
      local target="$HOME/bin/$tool"
      local source_path="$tools_dir/$tool"
      if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$source_path" ]]; then
        printf "${GREEN}✓${RESET} %-42s -> %s\n" "$target" "$source_path"
      else
        printf "${YELLOW}⚠ Not linked:${RESET} %s (run 'dots link')\n" "$target"
      fi
    done
    git -C "$tools_dir" status -sb
    printf "\n"
  fi

  ensure_repo_dir
  printf "${BLUE}==> Machine Config Symlinks (%s)${RESET}\n" "$REPO_DIR"
  for entry in "${MAPPINGS[@]}"; do
    local repo_name="${entry%%:*}"
    local target="${entry#*:}"
    local source_path="$REPO_DIR/$repo_name"
    if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$source_path" ]]; then
      printf "${GREEN}✓${RESET} %-42s -> %s\n" "$target" "$repo_name"
    elif [[ -e "$target" ]]; then
      printf "${YELLOW}⚠ Not linked:${RESET} %s (run 'dots link')\n" "$target"
    elif [[ -e "$source_path" ]]; then
      printf "${RED}✗ Missing:${RESET} %s (run 'dots link')\n" "$target"
    fi
  done

  printf "\n${BLUE}==> Machine Repo Git Status (%s)${RESET}\n" "$REPO_DIR"
  git -C "$REPO_DIR" status -sb
}

cmd_sync() {
  local msg="${1:-Update configs ($(date '+%Y-%m-%d %H:%M'))}"
  local tools_dir=""
  if tools_dir="$(resolve_tools_dir)"; then
    git -C "$tools_dir" add -A
    if ! git -C "$tools_dir" diff --cached --quiet; then
      printf "${BLUE}==> Syncing shared scripts (%s)${RESET}\n" "$tools_dir"
      git -C "$tools_dir" commit -m "$msg"
      if git -C "$tools_dir" remote get-url origin >/dev/null 2>&1; then
        local tbranch
        tbranch="$(git -C "$tools_dir" symbolic-ref --short HEAD 2>/dev/null | head -n 1 | tr -d '[:space:]')"
        [[ -z "$tbranch" ]] && tbranch="main"
        git -C "$tools_dir" pull --rebase origin "$tbranch"
        git -C "$tools_dir" push origin "$tbranch"
        printf "${GREEN}✓ Shared scripts synced!${RESET}\n\n"
      fi
    fi
  fi

  ensure_repo_dir
  cmd_brewfile
  git -C "$REPO_DIR" add -A
  if ! git -C "$REPO_DIR" diff --cached --quiet; then
    printf "\n${BLUE}==> Syncing machine configs (%s)${RESET}\n" "$REPO_DIR"
    git -C "$REPO_DIR" commit -m "$msg"
    if git -C "$REPO_DIR" remote get-url origin >/dev/null 2>&1; then
      local branch
      branch="$(git -C "$REPO_DIR" symbolic-ref --short HEAD 2>/dev/null | head -n 1 | tr -d '[:space:]')"
      [[ -z "$branch" ]] && branch="main"
      git -C "$REPO_DIR" pull --rebase origin "$branch"
      git -C "$REPO_DIR" push origin "$branch"
      printf "${BOLD}${GREEN}✨ Machine configs synced!${RESET}\n"
    else
      printf "${YELLOW}⚠ No 'origin' git remote configured in %s; changes committed locally.${RESET}\n" "$REPO_DIR"
    fi
  elif [[ -n "$(git -C "$REPO_DIR" status --porcelain -b 2>/dev/null | grep '^## .*\[ahead ')" ]]; then
    local branch
    branch="$(git -C "$REPO_DIR" symbolic-ref --short HEAD 2>/dev/null | head -n 1 | tr -d '[:space:]')"
    [[ -z "$branch" ]] && branch="main"
    git -C "$REPO_DIR" pull --rebase origin "$branch"
    git -C "$REPO_DIR" push origin "$branch"
    printf "${BOLD}${GREEN}✨ Machine configs synced!${RESET}\n"
  else
    printf "${GREEN}✓ Machine configs (%s) already up to date.${RESET}\n" "$REPO_DIR"
  fi
}

cmd_pull() {
  local tools_dir=""
  if tools_dir="$(resolve_tools_dir)"; then
    printf "${BLUE}==> Pulling shared scripts (%s)${RESET}\n" "$tools_dir"
    local tbranch
    tbranch="$(git -C "$tools_dir" symbolic-ref --short HEAD 2>/dev/null || echo "main")"
    git -C "$tools_dir" pull --rebase origin "$tbranch"
  fi

  ensure_repo_dir
  printf "\n${BLUE}==> Pulling machine configs (%s)${RESET}\n" "$REPO_DIR"
  local branch
  branch="$(git -C "$REPO_DIR" symbolic-ref --short HEAD 2>/dev/null || echo "main")"
  git -C "$REPO_DIR" pull --rebase origin "$branch"
  cmd_link
}

cmd_add() {
  ensure_repo_dir
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    printf "${RED}Usage: dots add <path-to-file> [repo-filename]${RESET}\n" >&2
    exit 1
  fi

  target="${target/#\~/$HOME}"
  if [[ ! -e "$target" ]]; then
    printf "${RED}File not found: %s${RESET}\n" "$target" >&2
    exit 1
  fi

  local abs_target
  abs_target="$(cd -P "$(dirname "$target")" && pwd)/$(basename "$target")"
  local repo_name="${2:-$(basename "$abs_target")}"
  repo_name="${repo_name#.}"
  local dest="$REPO_DIR/$repo_name"

  if [[ -L "$abs_target" ]] && [[ "$(readlink "$abs_target")" == "$dest" ]]; then
    printf "${GREEN}✓ %s is already tracked as %s${RESET}\n" "$abs_target" "$repo_name"
    return 0
  fi

  cp -a "$abs_target" "$dest"
  ln -sfn "$dest" "$abs_target"
  printf "${GREEN}✓ Added and linked:${RESET} %s -> %s\n" "$abs_target" "$dest"

  local tools_dir=""
  local dots_script=""
  if tools_dir="$(resolve_tools_dir)"; then
    dots_script="$tools_dir/dots"
  fi
  local mapping_entry="${repo_name}:${abs_target/#$HOME/\$HOME}"
  if [[ -n "$dots_script" ]] && [[ -f "$dots_script" ]] && ! grep -Fq "\"$mapping_entry\"" "$dots_script"; then
    local tmp_dots="${dots_script}.tmp.$$"
    awk -v entry="  \"$mapping_entry\"" '
      /^MAPPINGS=\(/ { in_map = 1 }
      in_map && /^\)/ { print entry; in_map = 0 }
      { print }
    ' "$dots_script" > "$tmp_dots" && chmod +x "$tmp_dots" && mv "$tmp_dots" "$dots_script"
    printf "${GREEN}✓ Registered %s in dots MAPPINGS${RESET}\n" "$mapping_entry"
  fi
}

COMMAND="${1:-status}"
shift || true

case "$COMMAND" in
  link|install)
    cmd_link
    ;;
  status|st)
    cmd_status
    ;;
  diff)
    ensure_repo_dir
    git -C "$REPO_DIR" diff
    ;;
  brewfile|brew)
    cmd_brewfile
    ;;
  sync|push)
    cmd_sync "${1:-}"
    ;;
  pull)
    cmd_pull
    ;;
  add|track)
    cmd_add "${1:-}" "${2:-}"
    ;;
  repo|init)
    configure_repo "${1:-}"
    ;;
  path)
    ensure_repo_dir
    printf "%s\n" "$REPO_DIR"
    ;;
  -v|--version|version)
    if tools_dir="$(resolve_tools_dir 2>/dev/null)"; then
      printf "dots v%s (r%s, %s)\n" "$DOTS_VERSION" "$(git -C "$tools_dir" rev-list --count HEAD 2>/dev/null || echo 0)" "$(git -C "$tools_dir" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    else
      printf "dots v%s (standalone)\n" "$DOTS_VERSION"
    fi
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    printf "${RED}Unknown command: %s${RESET}\n\n" "$COMMAND" >&2
    usage >&2
    exit 1
    ;;
esac
